/-- Exact base-graph automorphism 2. -/
def partsVertexPermutation2 (vertex : Fin 481) : Fin 481 :=
  match vertex.val / 64 with
  | 0 => partsVertexPermutation2Chunk0 (vertex.val % 64)
  | 1 => partsVertexPermutation2Chunk1 (vertex.val % 64)
  | 2 => partsVertexPermutation2Chunk2 (vertex.val % 64)
  | 3 => partsVertexPermutation2Chunk3 (vertex.val % 64)
  | 4 => partsVertexPermutation2Chunk4 (vertex.val % 64)
  | 5 => partsVertexPermutation2Chunk5 (vertex.val % 64)
  | 6 => partsVertexPermutation2Chunk6 (vertex.val % 64)
  | 7 => partsVertexPermutation2Chunk7 (vertex.val % 64)
  | _ => vertex

