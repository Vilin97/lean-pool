/-- The exact coordinate attached to a vertex number in the base graph. -/
def partsPoint (v : Fin 481) : PartsPoint :=
  match v.val / 64 with
  | 0 => partsPointChunk0 (v.val % 64)
  | 1 => partsPointChunk1 (v.val % 64)
  | 2 => partsPointChunk2 (v.val % 64)
  | 3 => partsPointChunk3 (v.val % 64)
  | 4 => partsPointChunk4 (v.val % 64)
  | 5 => partsPointChunk5 (v.val % 64)
  | 6 => partsPointChunk6 (v.val % 64)
  | 7 => partsPointChunk7 (v.val % 64)
  | _ => ⟨0, 0, 0, 0⟩

/-- Decidable unit adjacency used by the lower-bound certificate checker. -/
def partsAdjacent (v w : Fin 481) : Bool :=
  ((partsPoint v).sub (partsPoint w)).IsUnit

lemma dist_partsPoint_eq_one {v w : Fin 481} (h : partsAdjacent v w) :
    dist (partsPoint v).toR2 (partsPoint w).toR2 = 1 := by
  exact PartsPoint.dist_eq_one_of_isUnit h

lemma unitDistanceGraph_adj_of_partsAdjacent {v w : Fin 481}
    (h : partsAdjacent v w) :
    unitDistanceGraph.Adj (partsPoint v).toR2 (partsPoint w).toR2 := by
  rw [unitDistanceGraph_adj]
  have hd := dist_partsPoint_eq_one h
  have hne : (partsPoint v).toR2 ≠ (partsPoint w).toR2 := by
    intro heq
    rw [heq, dist_self] at hd
    norm_num at hd
  exact ⟨hne, Or.inl hd⟩

