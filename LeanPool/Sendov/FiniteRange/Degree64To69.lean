  pev_wsum_eq_of_packed (gg0 64) (gg1 64) (gg2 64) 30 91 Lc betac tauc Nmomc
    (by decide +kernel) (by decide +kernel)
    (rowZ_bound (gg0 64) (gg1 64) (gg2 64) 30 3 betac tauc (by decide +kernel)
      (by simp) (by simp) (by simp) (by decide +kernel))
    (by decide +kernel)
    (wsum_bound (gg0 64) (gg1 64) (gg2 64) 30 Lc betac (by decide +kernel) (by decide +kernel))
    (by decide +kernel)
    (wsum_length_le Lc _ 0
      (qrow_entry_length_le (gg0 64) (gg1 64) (gg2 64) 3 (by simp) (by simp) (by simp) 30))
    (by decide +kernel) α

theorem integral_lo (α : ℝ) (hα : 0 ≤ α) :
    (∫ t in (0 : ℝ)..1, t ^ 3 * Q 64 α t ^ 30)
      = pev Nmomc α / ((Lc : ℝ) * (2 * M 64 * (3 + α)) ^ 30) :=
  integral_moment_packed 64 30 (by norm_num) α hα Lc (by decide +kernel) Nmomc
    (by decide +kernel) (pev_Nmomc α)

