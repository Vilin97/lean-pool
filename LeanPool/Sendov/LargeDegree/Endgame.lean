/-- The Bernstein certificate: `F` is positive on `[0,17]`. -/
lemma F_pos (hα : 0 ≤ α) (hα' : α ≤ 17) : 0 < pev endF α :=
  pev_pos_of_bern endF endB 17 1 58 (by norm_num) (by norm_num) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) hα (by push_cast; linarith)

lemma gam_pos (hα : 0 ≤ α) (hα' : α ≤ 17) : (0 : ℝ) < 300 + 47 * α - α ^ 2 := by
  nlinarith

lemma endD_pos (hα : 0 ≤ α) (hα' : α ≤ 17) : 0 < pev endD α := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  have hg := gam_pos hα hα'
  rw [endD, pev_pscale, pev_pmul, pev_ppow, pev_ppow, pev_three_add, pev_gam]
  push_cast
  positivity

/-- `D · Ut = N`, with `(3+α) ^ 48` and `γ ^ 4` generalized away before clearing
denominators. -/
lemma endN_eq (hα : 0 ≤ α) (hα' : α ≤ 17) : pev endN α = Ut α * pev endD α := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  have hg := gam_pos hα hα'
  have hc : c 101 α = (300 + 47 * α - α ^ 2) / (100 * (3 + α)) := by
    simp only [c, M]
    norm_num
    field_simp
    ring
  have hT1 : T1 101 α
      = 1600000 * (100 - 2 * α) ^ 2 * (3 + α) ^ 3 / (721 * (300 + 47 * α - α ^ 2) ^ 4) := by
    simp only [T1, hc]
    norm_num
    field_simp
    ring
  rw [Ut, hT1, endN, endD]
  simp only [pev_padd, pev_pscale, pev_pmul, pev_ppow, pev_three_add, pev_gam, pev_lin, pev_X]
  push_cast
  rw [show (3 + α) ^ 49 = (3 + α) ^ 48 * (3 + α) from pow_succ _ _,
    show (3 + α) ^ 52 = (3 + α) ^ 48 * (3 + α) ^ 4 from by rw [← pow_add], div_pow]
  have hX : (0 : ℝ) < (3 + α) ^ 48 := pow_pos h3 48
  have hG : (0 : ℝ) < (300 + 47 * α - α ^ 2) ^ 4 := pow_pos hg 4
  generalize (3 + α) ^ 48 = X at hX ⊢
  generalize (300 + 47 * α - α ^ 2) ^ 4 = G at hG ⊢
  field_simp
  ring

/-- **The bound in `α` alone is below `1`.** -/
theorem Ut_lt_one (hα : 0 ≤ α) (hα' : α ≤ 17) : Ut α < 1 := by
  have hD := endD_pos hα hα'
  have hF := F_pos hα hα'
  rw [endF, pev_psub, endN_eq hα hα'] at hF
  rcases lt_or_ge (Ut α) 1 with h | h
  · exact h
  · exfalso
    nlinarith [mul_le_mul_of_nonneg_right h hD.le]

/-- **The large-degree claim.**  Every degree `n ≥ 101`. -/
theorem large_degree {n : ℕ} (hn : 101 ≤ n) (hα : 0 ≤ α) (hα' : α ≤ 17)
    (hfeas : c n α ^ 2 ≤ A n α) : R n α < 1 := by
  have hcpos : (0 : ℝ) < c n α := by
    have := c_ge_of_large hn hα hα'
    linarith
  exact lt_of_le_of_lt
    (le_trans (R_le_U (by omega) hα hfeas hcpos) (U_le_Ut hn hα hα'))
    (Ut_lt_one hα hα')

