  simp only [bGO, bcoef, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons, GO, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num
  ring_nf

theorem outPiece_12 (x : ℝ) (h1 : ((120) / 43 : ℝ) ≤ x) (h2 : x < (3 : ℝ)) :
    Eout x = ((36) / 5 : ℝ) * x + ((-9) : ℝ) := by
  rw [Eout_expand (q := 2) (q' := 0) (μ := 5) (by norm_num; linarith) (by norm_num; linarith)
      (by norm_num; linarith) (by norm_num; linarith) (by norm_num; linarith)
      (by norm_num; linarith) (by linarith)]
  have hf0 : (0 : ℝ) ≤ x - (2 : ℝ) := by linarith
  have hf1 : x - (2 : ℝ) < 1 := by linarith
  have hg0 : (0 : ℝ) ≤ 3 / 40 * x - (0 : ℝ) := by linarith
  have hg1 : 3 / 40 * x - (0 : ℝ) < 1 := by linarith
  have e00 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 0 0 = ((0 : ℝ) * x + ((1) / 2 : ℝ)) := by
    rw [cc00]
    ring
  have e01 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 0 1 =
      (((3) / 40 : ℝ) * x + (0 : ℝ)) := by
    rw [cc01 hg0 hg1]
    simp only [min_def]
    split_ifs <;> linarith
  have e02 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 0 2 = ((0 : ℝ) * x + (0 : ℝ)) := by
    rw [cc02 hg1]
    simp only [max_def]
    split_ifs <;> linarith
  have e10 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 1 0 = ((0 : ℝ) * x + ((1) / 2 : ℝ)) := by
    rw [cc10 hf0 hf1]
    simp only [min_def]
    split_ifs <;> linarith
  have e11 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 1 1 =
      (((3) / 40 : ℝ) * x + (0 : ℝ)) := by
    rw [cc11 hf0 hf1 hg0]
    simp only [min_def]
    split_ifs <;> linarith
  have e12 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 1 2 = ((0 : ℝ) * x + (0 : ℝ)) := by
    rw [cc12 hg1]
    simp only [min_def, max_def]
    split_ifs <;> linarith
  have e20 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 2 0 =
      ((1 : ℝ) * x + ((-5) / 2 : ℝ)) := by
    rw [cc20 hf1]
    simp only [max_def]
    split_ifs <;> linarith
  have e21 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 2 1 =
      (((43) / 40 : ℝ) * x + ((-3) : ℝ)) := by
    rw [cc21 hf1]
    simp only [min_def, max_def]
    split_ifs <;> linarith
  have e22 :
    ccount (x - (2 : ℝ)) (3 / 40 * x - (0 : ℝ)) 2 2 = ((0 : ℝ) * x + (0 : ℝ)) := by
    rw [cc22 hg1]
    simp only [min_def, max_def]
    split_ifs <;> linarith
  have em : max 0 (13 / 10 * x - 2) = (((13) / 10 : ℝ) * x + ((-2) : ℝ)) := by
    (try simp only [max_def]); (try split_ifs) <;> linarith
  push_cast
  simp only [Fin.sum_univ_three]
  rw [e00, e01, e02, e10, e11, e12, e20, e21, e22, em]
  simp only [bGO, bcoef, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons, GO, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num
  ring_nf

/-- The 14 rational endpoints of the 13 outer-range linear pieces. -/
@[expose] def tOutL : List ℚ :=
  [(20 / 37), (40 / 43), (1), (40 / 37), (3 / 2), (20 / 13), (60 / 37), (80 / 43), (2), (80 / 37),
    (5 / 2), (100 / 37), (120 / 43), (3)]

/-- Rational slopes of the 13 outer-range linear pieces. -/
@[expose] def aOutL : List ℚ :=
  [(37 / 20), (37 / 20), (1), (42 / 5), (42 / 5), (97 / 10), (231 / 20), (51 / 10), (17 / 4),
    (429 / 40), (429 / 40), (503 / 40), (36 / 5)]

/-- Rational intercepts of the 13 outer-range linear pieces. -/
@[expose] def bOutL : List ℚ :=
  [(-1), (-1), (-2), (-10), (-10), (-12), (-15), (-3), (-5), (-19), (-19), (-24), (-9)]

/-- The `i`th outer-range endpoint as a real number; zero outside the table. -/
@[expose] noncomputable def tOut (i : ℕ) : ℝ :=
  ((tOutL.getD i 0 : ℚ) : ℝ)

/-- The affine bound on outer piece `i`, with coefficients from `aOutL` and `bOutL`. -/
@[expose] noncomputable def gOut (i : ℕ) (x : ℝ) : ℝ :=
  ((aOutL.getD i 0 : ℚ) : ℝ) * x + ((bOutL.getD i 0 : ℚ) : ℝ)

theorem tOut_mono : ∀ i < 13, tOut i < tOut (i + 1) := by
  intro i hi
  interval_cases i <;> simp only [tOut, tOutL, List.getD_cons_succ, List.getD_cons_zero] <;>
    norm_num

theorem outer_table : ∀ i < 13, ∀ x ∈ Set.Ico (tOut i) (tOut (i + 1)), Eout x = gOut i x := by
  intro i hi x hx
  interval_cases i
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_0 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_1 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_2 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_3 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_4 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_5 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_6 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_7 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_8 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_9 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_10 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
    push_cast at hx ⊢
    have := outPiece_11 x (by linarith [hx.1]) (by linarith [hx.2])
    linarith
  · simp only [tOut, tOutL, gOut, aOutL, bOutL, List.getD_cons_succ, List.getD_cons_zero,
      Set.mem_Ico] at hx ⊢
