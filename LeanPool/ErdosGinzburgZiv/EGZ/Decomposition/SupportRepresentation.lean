import LeanPool.ErdosGinzburgZiv.EGZ.Decomposition.MinimalRepresentation

/-!
# Representations generated by cumulative supports

Affine coordinate maps compatible on the nonzero cumulative atoms extend to
compatible maps on their affine spans. If their support images are reductions
of integer affine generators, these maps are surjective on the spans. This
constructs a representation without assuming surjectivity of the original
coordinate maps on the ambient space.
-/

open scoped BigOperators

namespace EGZ

namespace FlagDecompositionRaw

variable {p d : ℕ} {F : ConvexFlag}

open Classical in
/-- Local weights contribute to the cumulative weight at their own node. -/
theorem localWeight_le_cumulative (w : F.Node → FpCoord p d → ℕ)
    (x : F.Node) (v : FpCoord p d) : w x v ≤ cumulativeWeight w x v := by
  unfold cumulativeWeight
  simpa using Finset.single_le_sum
    (f := fun y ↦ if y ≤ x then w y v else 0)
    (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ x)

open Classical in
/-- Cumulative weight is monotone in its node. -/
theorem cumulativeWeight_node_mono (w : F.Node → FpCoord p d → ℕ)
    {x y : F.Node} (h : x ≤ y) (v : FpCoord p d) :
    cumulativeWeight w x v ≤ cumulativeWeight w y v := by
  unfold cumulativeWeight
  apply Finset.sum_le_sum
  intro z _
  by_cases hz : z ≤ x
  · simp [hz, hz.trans h]
  · simp [hz]

end FlagDecompositionRaw

namespace FpRepresentation

variable {p d : ℕ} {F : ConvexFlag}

open Classical in
/-- The smallest ambient affine space containing the cumulative support. -/
def cumulativeSpace (w : F.Node → FpCoord p d → ℕ) (x : F.Node) :
    AffineSubspace (ZMod p) (FpCoord p d) :=
  affineSpan (ZMod p) {v | FlagDecompositionRaw.cumulativeWeight w x v ≠ 0}

open Classical in
theorem cumulativeSpace_mono (w : F.Node → FpCoord p d → ℕ)
    {x y : F.Node} (h : x ≤ y) : cumulativeSpace w x ≤ cumulativeSpace w y := by
  apply affineSpan_mono
  intro v hv
  exact ne_of_gt ((Nat.pos_of_ne_zero hv).trans_le
    (FlagDecompositionRaw.cumulativeWeight_node_mono w h v))

open Classical in
theorem local_supported_cumulativeSpace (w : F.Node → FpCoord p d → ℕ)
    (x : F.Node) (v : FpCoord p d) (hv : w x v ≠ 0) : v ∈ cumulativeSpace w x := by
  apply subset_affineSpan (ZMod p)
  exact ne_of_gt ((Nat.pos_of_ne_zero hv).trans_le
    (FlagDecompositionRaw.localWeight_le_cumulative w x v))

open Classical in
/-- Compatibility on nonzero cumulative atoms extends to the full affine
space generated by those atoms. -/
theorem compatible_on_cumulativeSpace (w : F.Node → FpCoord p d → ℕ)
    (ψ : (x : F.Node) → FpCoord p d →ᵃ[ZMod p] FpCoord p (F.rank x))
    (hcompat : ∀ {x y : F.Node} (h : x ≤ y) {v : FpCoord p d},
      FlagDecompositionRaw.cumulativeWeight w x v ≠ 0 →
        ψ y v = (F.transition h).modp p (ψ x v))
    {x y : F.Node} (h : x ≤ y) {v : FpCoord p d} (hv : v ∈ cumulativeSpace w x) :
    ψ y v = (F.transition h).modp p (ψ x v) :=
  AffineMap.eqOn_affineSpan (f := ψ y) (g := ((F.transition h).modp p).comp (ψ x))
    (fun _ hw ↦ hcompat h hw) hv

open Classical in
/-- Construct a representation from its cumulative support images. Integer
affine generation supplies surjectivity, and compatibility is needed only on
the nonzero cumulative atoms. -/
noncomputable def ofCumulativeSupport [NeZero p] [Fact p.Prime]
    (w : F.Node → FpCoord p d → ℕ)
    (ψ : (x : F.Node) → FpCoord p d →ᵃ[ZMod p] FpCoord p (F.rank x))
    (S : (x : F.Node) → Finset (IntCoord (F.rank x)))
    (hS : ∀ x, FlagDecomposition.AffineIntSpans (S x))
    (himage : ∀ x, ψ x '' {v | FlagDecompositionRaw.cumulativeWeight w x v ≠ 0} =
      IntCoord.mod p '' (S x : Set (IntCoord (F.rank x))))
    (hcompat : ∀ {x y : F.Node} (h : x ≤ y) {v : FpCoord p d},
      FlagDecompositionRaw.cumulativeWeight w x v ≠ 0 →
        ψ y v = (F.transition h).modp p (ψ x v))
    (hlattice : ∀ (x : F.Node) (q : RealCoord (F.rank x)),
      q ∈ F.lattice x ↔ EGZ.IsIntegral q) : FpRepresentation p d F where
  space := cumulativeSpace (F := F) w
  map := ψ
  space_mono h := cumulativeSpace_mono (F := F) w h
  map_surjective x := by
    have hspan : affineSpan (ZMod p)
        (ψ x '' {v | FlagDecompositionRaw.cumulativeWeight w x v ≠ 0}) = ⊤ := by
      rw [himage x]
      exact (hS x).affineSpan_mod_eq_top
    intro q _
    have hq : q ∈ affineSpan (ZMod p)
        (ψ x '' {v | FlagDecompositionRaw.cumulativeWeight w x v ≠ 0}) := by
      rw [hspan]
      trivial
    rw [← AffineSubspace.map_span] at hq
    exact hq
  compatible h := compatible_on_cumulativeSpace (F := F) w ψ hcompat h
  lattice_eq_standard := hlattice

end FpRepresentation
end EGZ
