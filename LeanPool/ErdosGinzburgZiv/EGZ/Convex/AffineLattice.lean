module


public import LeanPool.ErdosGinzburgZiv.EGZ.Convex.Polytope
public import Mathlib.Data.Rat.Cast.CharZero

/-!
# Affine lattices generated by rational points

A finite rational set has a common denominator.  Consequently its affine
integer span is contained in a rescaled copy of the standard integer lattice,
so its intersection with a compact set is finite.
-/

@[expose] public section

open scoped BigOperators

namespace EGZ

/-- The explicit finite-combination definition of `affineIntSpan` agrees
with Mathlib's affine span over `ℤ`.  This characterization supplies the
closure laws of the support-generated lattices used by the face flag. -/
theorem affineIntSpan_eq_affineSpan_int {d : ℕ} (S : Set (RealCoord d)) :
    affineIntSpan S = (affineSpan ℤ S : Set (RealCoord d)) := by
  classical
  ext q
  constructor
  · rintro ⟨k, points, coeff, hpoints, hsum, rfl⟩
    have hmem :
        (Finset.univ.affineCombination ℤ points coeff : RealCoord d) ∈
          affineSpan ℤ (Set.range points) :=
      affineCombination_mem_affineSpan (by simpa using hsum) points
    have hmono :
        affineSpan ℤ (Set.range points) ≤ affineSpan ℤ S :=
      affineSpan_mono ℤ
        (Set.range_subset_iff.mpr hpoints)
    have hmem' := hmono hmem
    rw [Finset.affineCombination_eq_linear_combination _ _ _
      (by simpa using hsum)] at hmem'
    have heq :
        (∑ i, (coeff i : ℝ) • points i) = ∑ i, coeff i • points i := by
      apply Finset.sum_congr rfl
      intro i _
      exact Int.cast_smul_eq_zsmul ℝ (coeff i) (points i)
    rw [heq]
    exact hmem'
  · intro hq
    let points : S → RealCoord d := fun x ↦ x.1
    have hrange : Set.range points = S := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        exact y.2
      · intro hx
        exact ⟨⟨x, hx⟩, rfl⟩
    have hq' : q ∈ affineSpan ℤ (Set.range points) := by
      rwa [hrange]
    obtain ⟨t, weight, hweight, hqeq⟩ :=
      eq_affineCombination_of_mem_affineSpan hq'
    let e : Fin t.card ≃ {x // x ∈ t} :=
      Fintype.equivOfCardEq (by simp)
    refine ⟨t.card, fun i ↦ points (e i), fun i ↦ weight (e i), ?_, ?_, ?_⟩
    · intro i
      exact (e i).1.2
    · calc
        (∑ i, weight (e i)) = ∑ x : {x // x ∈ t}, weight x :=
          e.sum_comp (fun x ↦ weight x)
        _ = ∑ x ∈ t, weight x := by
          simpa only [Finset.attach_eq_univ] using
            (Finset.sum_attach t weight)
        _ = 1 := hweight
    · rw [hqeq, Finset.affineCombination_eq_linear_combination _ _ _ hweight]
      apply Eq.symm
      calc
        (∑ i, (weight (e i) : ℝ) • points (e i)) =
            ∑ x : {x // x ∈ t}, (weight x : ℝ) • points x :=
          e.sum_comp (fun x ↦ (weight x : ℝ) • points x)
        _ = ∑ x ∈ t, (weight x : ℝ) • points x := by
          simpa only [Finset.attach_eq_univ] using
            (Finset.sum_attach t (fun x ↦ (weight x : ℝ) • points x))
        _ = ∑ x ∈ t, weight x • points x := by
          apply Finset.sum_congr rfl
          intro x hx
          exact Int.cast_smul_eq_zsmul ℝ (weight x) (points x)

/-- Affine integer span is monotone. -/
theorem affineIntSpan_mono {d : ℕ} {S T : Set (RealCoord d)} (hST : S ⊆ T) :
    affineIntSpan S ⊆ affineIntSpan T := by
  rw [affineIntSpan_eq_affineSpan_int, affineIntSpan_eq_affineSpan_int]
  exact affineSpan_mono ℤ hST

/-- Taking the affine integer span twice does not enlarge it. -/
theorem affineIntSpan_idempotent {d : ℕ} (S : Set (RealCoord d)) :
    affineIntSpan (affineIntSpan S) = affineIntSpan S := by
  rw [affineIntSpan_eq_affineSpan_int, affineIntSpan_eq_affineSpan_int,
    AffineSubspace.affineSpan_coe]

/-- Every generator belongs to its affine integer span. -/
theorem subset_affineIntSpan {d : ℕ} (S : Set (RealCoord d)) :
    S ⊆ affineIntSpan S := by
  rw [affineIntSpan_eq_affineSpan_int]
  exact subset_affineSpan ℤ S

/-- Integer affine combinations of rational points are rational. -/
theorem isRational_of_mem_affineIntSpan {d : ℕ}
    {S : Set (RealCoord d)}
    (hS : ∀ q ∈ S, IsRational q) {q : RealCoord d}
    (hq : q ∈ affineIntSpan S) : IsRational q := by
  classical
  obtain ⟨k, points, coeff, hpoints, _hsum, hqeq⟩ := hq
  intro j
  choose value hvalue using fun i ↦ hS (points i) (hpoints i) j
  refine ⟨∑ i, (coeff i : ℚ) * value i, ?_⟩
  rw [hqeq]
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  push_cast
  apply Finset.sum_congr rfl
  intro i _
  rw [hvalue i]

/-- A rational point becomes integral after multiplication by one positive
integer. -/
theorem IsRational.exists_integral_nsmul {d : ℕ} {q : RealCoord d}
    (hq : IsRational q) :
    ∃ D : ℕ, 0 < D ∧ IsIntegral ((D : ℝ) • q) := by
  classical
  choose r hr using hq
  let D : ℕ := ∏ i : Fin d, (r i).den
  have hD : 0 < D := by
    dsimp [D]
    exact Finset.prod_pos fun i _ ↦ (r i).den_pos
  let z : IntCoord d := fun i ↦
    (r i).num * (∏ j ∈ ({i} : Finset (Fin d))ᶜ, (r j).den : ℕ)
  refine ⟨D, hD, z, ?_⟩
  funext i
  have hprod : D =
      (r i).den * ∏ j ∈ ({i} : Finset (Fin d))ᶜ, (r j).den := by
    simpa [D] using
      (Fintype.prod_eq_mul_prod_compl i (fun j : Fin d ↦ (r j).den))
  change (z i : ℝ) = (D : ℝ) * q i
  rw [← hr i, hprod]
  simp only [z, Rat.cast_def]
  push_cast
  field_simp

/-- Integral points remain integral after multiplication by a natural
number. -/
theorem IsIntegral.nat_smul {d : ℕ} {q : RealCoord d}
    (hq : IsIntegral q) (m : ℕ) : IsIntegral ((m : ℝ) • q) := by
  obtain ⟨z, rfl⟩ := hq
  refine ⟨m • z, ?_⟩
  funext i
  simp [IntCoord.real]

/-- A finite set of rational points admits one positive common denominator
in every coordinate. -/
theorem Set.Finite.exists_common_integral_nsmul {d : ℕ}
    {S : Set (RealCoord d)} (hS : S.Finite)
    (hSrational : ∀ q ∈ S, IsRational q) :
    ∃ D : ℕ, 0 < D ∧ ∀ q ∈ S, IsIntegral ((D : ℝ) • q) := by
  classical
  let _ := hS.fintype
  let denom (q : S) : ℕ :=
    Classical.choose (hSrational q q.property).exists_integral_nsmul
  have hdenom_pos (q : S) : 0 < denom q :=
    (Classical.choose_spec
      (hSrational q q.property).exists_integral_nsmul).1
  have hdenom_integral (q : S) :
      IsIntegral ((denom q : ℝ) • (q : RealCoord d)) :=
    (Classical.choose_spec
      (hSrational q q.property).exists_integral_nsmul).2
  let D : ℕ := ∏ q : S, denom q
  have hD : 0 < D := by
    dsimp [D]
    exact Finset.prod_pos fun q _ ↦ hdenom_pos q
  refine ⟨D, hD, ?_⟩
  intro q hqS
  let s : S := ⟨q, hqS⟩
  let rest : ℕ := ∏ t ∈ ({s} : Finset S)ᶜ, denom t
  have hprod : D = denom s * rest := by
    simpa [D, rest] using
      (Fintype.prod_eq_mul_prod_compl s denom)
  have hint : IsIntegral ((rest : ℝ) •
      ((denom s : ℝ) • (s : RealCoord d))) :=
    (hdenom_integral s).nat_smul rest
  convert hint using 1
  ext i
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [hprod]
  push_cast
  ring

/-- A common denominator for the generators is also a common denominator
for every integer affine combination of them. -/
theorem isIntegral_nsmul_of_mem_affineIntSpan {d D : ℕ}
    {S : Set (RealCoord d)}
    (hS : ∀ q ∈ S, IsIntegral ((D : ℝ) • q))
    {q : RealCoord d} (hq : q ∈ affineIntSpan S) :
    IsIntegral ((D : ℝ) • q) := by
  classical
  rcases hq with ⟨k, points, coeff, hpoints, _hsum, rfl⟩
  have hi (i : Fin k) : IsIntegral ((D : ℝ) • points i) :=
    hS (points i) (hpoints i)
  choose z hz using hi
  refine ⟨∑ i, coeff i • z i, ?_⟩
  funext j
  simp only [IntCoord.real_apply, Finset.sum_apply, Pi.smul_apply,
    smul_eq_mul]
  push_cast
  simp_rw [show (z _ j : ℝ) = (D : ℝ) * points _ j from congrFun (hz _) j]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  ring

/-- A compact set meets the affine integer span of a finite rational set in
only finitely many points.  No affine independence or full-dimensionality is
required. -/
theorem finite_inter_affineIntSpan_of_isCompact {d : ℕ}
    {S K : Set (RealCoord d)} (hSfinite : S.Finite)
    (hSrational : ∀ q ∈ S, IsRational q) (hK : IsCompact K) :
    (K ∩ affineIntSpan S).Finite := by
  classical
  obtain ⟨D, hD, hDintegral⟩ :=
    Set.Finite.exists_common_integral_nsmul hSfinite hSrational
  let scale : RealCoord d → RealCoord d := fun q ↦ (D : ℝ) • q
  have hscale_continuous : Continuous scale := by
    exact continuous_const_smul (D : ℝ)
  have hscaleK : IsCompact (scale '' K) :=
    hK.image hscale_continuous
  have hfinite : Set.Finite
      {q | q ∈ scale '' K ∧ IsIntegral q} :=
    RationalPolytope.finite_integral_of_isCompact hscaleK
  apply Set.Finite.of_finite_image (f := scale)
  · apply hfinite.subset
    rintro y ⟨q, ⟨hqK, hqspan⟩, rfl⟩
    exact ⟨⟨q, hqK, rfl⟩,
      isIntegral_nsmul_of_mem_affineIntSpan hDintegral hqspan⟩
  · exact (smul_right_injective (RealCoord d)
      (by exact_mod_cast (Nat.ne_of_gt hD))).injOn

/-- A finitely generated rational polytope is compact. -/
theorem RationalPolytope.isCompact {d : ℕ} (P : RationalPolytope d) :
    IsCompact P.carrier := by
  rw [P.carrier_eq_convexHull]
  exact P.generators.finite_toSet.isCompact_convexHull ℝ

/-! ## Abstract affine lattices

For convex flags we only need the carrier of an affine lattice, closure under
integer affine combinations, and local finiteness.  Packaging precisely those
properties lets a flag use a different lattice in every fibre without first
choosing bases which identify all of them with standard integer coordinates.
-/

/-- A locally finite affine `ℤ`-lattice in real coordinate space.

The carrier is required to be nonempty and closed under finite integer affine
combinations.  `finite_inter_compact` is the operational discreteness property
used to make the population of integral points in a bounded flag fibre finite.
-/
structure AffineLattice (d : ℕ) where
  /-- Underlying set of points in the affine lattice. -/
  carrier : Set (RealCoord d)
  nonempty : carrier.Nonempty
  affineIntSpan_closed : affineIntSpan carrier ⊆ carrier
  finite_inter_compact : ∀ {K : Set (RealCoord d)}, IsCompact K →
    (K ∩ carrier).Finite

namespace AffineLattice

instance {d : ℕ} : Membership (RealCoord d) (AffineLattice d) :=
  ⟨fun L q ↦ q ∈ L.carrier⟩

/-- Membership in an affine lattice is membership in its carrier. -/
@[simp]
theorem mem_carrier {d : ℕ} (L : AffineLattice d) (q : RealCoord d) :
    q ∈ L.carrier ↔ q ∈ L := Iff.rfl

/-- Only finitely many points of an affine lattice lie in a compact set. -/
theorem finite_mem_of_isCompact {d : ℕ} (L : AffineLattice d)
    {K : Set (RealCoord d)} (hK : IsCompact K) :
    {q | q ∈ K ∧ q ∈ L}.Finite := by
  change (K ∩ L.carrier).Finite
  exact L.finite_inter_compact hK

/-- The standard integer lattice in the chosen coordinates. -/
def standard (d : ℕ) : AffineLattice d where
  carrier := {q | IsIntegral q}
  nonempty := ⟨0, ⟨0, by ext i; simp [IntCoord.real]⟩⟩
  affineIntSpan_closed := by
    intro q hq
    have h := isIntegral_nsmul_of_mem_affineIntSpan
      (D := 1) (S := {q : RealCoord d | IsIntegral q})
      (fun x hx ↦ by simpa using hx) hq
    simpa using h
  finite_inter_compact := by
    intro K hK
    exact RationalPolytope.finite_integral_of_isCompact hK

/-- The affine lattice generated by a finite nonempty rational set. -/
noncomputable def span {d : ℕ} (S : Set (RealCoord d))
    (hfinite : S.Finite) (hnonempty : S.Nonempty)
    (hrational : ∀ q ∈ S, IsRational q) : AffineLattice d where
  carrier := affineIntSpan S
  nonempty := hnonempty.mono (subset_affineIntSpan S)
  affineIntSpan_closed := by
    rw [affineIntSpan_idempotent]
  finite_inter_compact := by
    intro K hK
    exact finite_inter_affineIntSpan_of_isCompact hfinite hrational hK

end AffineLattice

end EGZ
