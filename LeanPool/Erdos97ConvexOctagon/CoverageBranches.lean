/-! # Erdős 97 convex-octagon formalization: Coverage Branches -/

namespace Erdos97Octagon.RawIncidence

/-- All 35 canonical second rows are impossible for first-row orbit 0. -/
theorem canonicalBranchRow00_impossible
    {p : Vertex → Plane} {Q : OctagonIncidence}
    (hC : ConvexIndependent ℝ p) (hR : Realises p Q)
    (hN : Q.Normalized) (hSparse : Q.PairSparse) (hBalanced : Q.Balanced)
    (rowTwoIndex : Fin 35)
    (hrowOne : Q.targets 1 = packedRow (canonicalRowMask (0 : Fin 7)))
    (hrowTwo : Q.targets 2 = packedRow (rowTwoMask rowTwoIndex)) : False := by
  fin_cases rowTwoIndex
  · exact coverageBranchR100R200_impossible hC hR hN hSparse hBalanced hrowOne hrowTwo
  · exact coverageBranchR100R201_impossible hC hR hN hSparse hBalanced hrowOne hrowTwo
  · exact coverageBranchR100R202_impossible hC hR hN hSparse hBalanced hrowOne hrowTwo
