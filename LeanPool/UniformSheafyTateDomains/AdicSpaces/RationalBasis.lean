import LeanPool.UniformSheafyTateDomains.AdicSpaces.RationalIntersection
import LeanPool.UniformSheafyTateDomains.AdicSpaces.StructurePresheafLimit
import LeanPool.UniformSheafyTateDomains.AdicSpaces.SpaQCviaSpvAI
import LeanPool.UniformSheafyTateDomains.AdicSpaces.SpaCompactNoHArch

/-!
# The rational basis of `Spa (A, A⁺)` and quasi-compactness (Wedhorn 7.35, Tate case)

**R2 of the sheafiness program.** Two facts the sheaf-comparison phase consumes:

* `isCompact_spaOpen` — every valid rational open of `Spa (A, A⁺)` is quasi-compact
  (Wedhorn Theorem 7.35(3); re-export of the project's `noHArch` compactness at the
  `IsRingOfIntegralElements` interface).
* `exists_isRational_spaOpen_subset` — the **basis property** (Wedhorn Theorem 7.35(2)):
  every open `V ∋ v` contains a valid rational open `spaOpen D ∋ v`. Derived from the
  `RCoord`-profile inducing (`isInducing_ιSpvPropR_spa`): the subspace topology is
  generated by the traces of side-condition rational subsets; over a Tate ring with a
  principal pair the side condition `I ≤ √(span T)` forces `span T = ⊤` (a power of the
  topologically nilpotent **unit** lands in `span T`), so every subbasic trace is a valid
  rational open, and finite intersections fold through `interRational` (R1).
-/

noncomputable section

open TopologicalSpace

namespace ValuationSpectrum

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [PlusSubring A] [IsHuberRing A] [DecidableEq A] [IsTateRing A]

/-! ### Quasi-compactness (Wedhorn 7.35(3)) -/

/-- **Valid rational opens are quasi-compact** (Wedhorn Theorem 7.35(3)) — the
`IsRingOfIntegralElements` form of `isCompact_preimage_rationalOpen_noHArch`. -/
theorem isCompact_spaOpen [IsRingOfIntegralElements (A⁺ : Subring A)]
    (D : RationalLocData A) (hD : D.IsRational) : IsCompact (spaOpen D) :=
  isCompact_preimage_rationalOpen_noHArch
    (IsRingOfIntegralElements.isOpen (B := (A⁺ : Subring A))) D hD

/-! ### Side-condition coordinates are valid rational data -/

/-- Over a Tate ring, if some **unit** lies in `I`, the `RCoord` side condition
`I ≤ √(span T)` forces `span T = ⊤` (Wedhorn Remark 7.30(1): open ideals of Tate rings
are the unit ideal). -/
theorem RCoord.span_eq_top {I : Ideal A} (hπI : ∃ π : A, IsUnit π ∧ π ∈ I)
    (p : RCoord A I) : Ideal.span ((p.1.1 : Finset A) : Set A) = ⊤ := by
  obtain ⟨π, hu, hπ⟩ := hπI
  obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff.mp (p.2 hπ))
  exact Ideal.eq_top_of_isUnit_mem _ hn (hu.pow n)

/-- The valid rational datum of a side-condition coordinate (pair `P`, tray `p.1.1`,
denominator `p.1.2`; `hopen` from the spanning tray). -/
def RCoord.toDatum (P : PairOfDefinition A) {I : Ideal A}
    (hπI : ∃ π : A, IsUnit π ∧ π ∈ I) (p : RCoord A I) : RationalLocData A :=
  genPieceDatum P p.1.1 p.1.2 (p.span_eq_top hπI)

theorem RCoord.toDatum_isRational (P : PairOfDefinition A) {I : Ideal A}
    (hπI : ∃ π : A, IsUnit π ∧ π ∈ I) (p : RCoord A I) :
    (p.toDatum P hπI).IsRational :=
  RationalLocData.isRational_of_span_eq_top (p.span_eq_top hπI)

/-- The `Spa`-trace of a side-condition coordinate is the rational open of its datum. -/
theorem RCoord.spaOpen_toDatum (P : PairOfDefinition A) {I : Ideal A}
    (hπI : ∃ π : A, IsUnit π ∧ π ∈ I) (p : RCoord A I) :
    spaOpen (p.toDatum P hπI) = {v : ↥(Spa A A⁺) | ιSpvR I (v : Spv A) p = true} := by
  ext v
  rw [Set.mem_setOf_eq, ιSpvR_eq_true_iff]
  constructor
  · rintro ⟨-, hvle, hs0⟩
    exact ⟨hvle, hs0⟩
  · rintro ⟨hvle, hs0⟩
    exact ⟨v.2, hvle, hs0⟩

/-! ### `spaOpen` and intersections -/

theorem spaOpen_interRational (D E : RationalLocData A)
    (hD : D.IsRational) (hE : E.IsRational) :
    spaOpen (D.interRational E hD hE) = spaOpen D ∩ spaOpen E := by
  unfold spaOpen
  rw [RationalLocData.interRational_rationalOpen, Set.preimage_inter]

theorem spaOpen_globalLocData (P : PairOfDefinition A) :
    spaOpen (globalLocData P) = Set.univ := by
  have h := spaOpens_globalLocData (A := A) P
  simpa [spaOpens, SetLike.ext'_iff] using congrArg (fun U : Opens ↥(Spa A A⁺) =>
    (U : Set ↥(Spa A A⁺))) h

/-! ### The basis property (Wedhorn 7.35(2)) -/

/-- The subspace topology of `Spa (A, A⁺)` is generated by the traces of the
side-condition rational subsets (the `RCoord`-profile is inducing and the sierpiński
product topology is generated coordinatewise). -/
theorem spa_topology_eq_generateFrom (P : PairOfDefinition A) (I : Ideal A)
    (hIeq : I = Ideal.span (P.A₀.subtype '' (P.I : Set P.A₀))) :
    (inferInstance : TopologicalSpace ↥(Spa A A⁺)) =
      generateFrom {S | ∃ p : RCoord A I,
        S = {v : ↥(Spa A A⁺) | ιSpvR I (v : Spv A) p = true}} := by
  have hInd := isInducing_ιSpvPropR_spa (A := A) P I hIeq
  rw [hInd.eq_induced]
  show TopologicalSpace.induced _ (Pi.topologicalSpace) = _
  rw [show (Pi.topologicalSpace : TopologicalSpace (RCoord A I → Prop)) =
      ⨅ p : RCoord A I, TopologicalSpace.induced (fun x => x p) sierpinskiSpace from rfl,
    induced_iInf]
  simp only [induced_compose]
  rw [show (sierpinskiSpace : TopologicalSpace Prop) =
      generateFrom {{True}} from rfl]
  simp only [induced_generateFrom_eq]
  rw [← generateFrom_iUnion]
  congr 1
  ext S
  simp only [Set.mem_iUnion, Set.image_singleton, Set.mem_singleton_iff, Set.mem_setOf_eq]
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨p, ?_⟩
    ext v
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq,
      Function.comp_apply]
    show ιSpvPropR I (v : Spv A) p = True ↔ _
    rw [show ιSpvPropR I (v : Spv A) p = (ιSpvR I (v : Spv A) p = true) from rfl,
      eq_iff_iff, iff_true]
  · rintro ⟨p, rfl⟩
    refine ⟨p, ?_⟩
    ext v
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq,
      Function.comp_apply]
    show _ ↔ ιSpvPropR I (v : Spv A) p = True
    rw [show ιSpvPropR I (v : Spv A) p = (ιSpvR I (v : Spv A) p = true) from rfl,
      eq_iff_iff, iff_true]

/-- Finite intersections of side-condition traces are valid rational opens
(`interRational`-fold; the empty intersection is `R({1}/1)`). -/
theorem exists_isRational_spaOpen_eq_sInter (P : PairOfDefinition A) {I : Ideal A}
    (hπI : ∃ π : A, IsUnit π ∧ π ∈ I)
    (𝒮 : Set (Set ↥(Spa A A⁺))) (h𝒮 : 𝒮.Finite)
    (hsub : 𝒮 ⊆ {S | ∃ p : RCoord A I,
      S = {v : ↥(Spa A A⁺) | ιSpvR I (v : Spv A) p = true}}) :
    ∃ D : RationalLocData A, D.IsRational ∧ spaOpen D = ⋂₀ 𝒮 := by
  induction 𝒮, h𝒮 using Set.Finite.induction_on with
  | empty =>
    exact ⟨globalLocData P, globalLocData_isRational P, by
      rw [Set.sInter_empty, spaOpen_globalLocData]⟩
  | @insert t 𝒮' htmem h𝒮'fin ih =>
    obtain ⟨D', hD'rat, hD'eq⟩ := ih (fun S hS => hsub (Set.mem_insert_of_mem t hS))
    obtain ⟨p, rfl⟩ := hsub (Set.mem_insert t 𝒮')
    refine ⟨(p.toDatum P hπI).interRational D' (p.toDatum_isRational P hπI) hD'rat,
      RationalLocData.interRational_isRational _ _ _ _, ?_⟩
    rw [spaOpen_interRational, RCoord.spaOpen_toDatum, hD'eq, Set.sInter_insert]

/-- **The rational basis of `Spa (A, A⁺)`** (Wedhorn Theorem 7.35(2), Tate case): every
open neighbourhood contains a **valid** rational open neighbourhood. This is the
refinement input for the sheaf-comparison phase (arbitrary covers reduce to rational
covers) and, with `isCompact_spaOpen`, for the finite-subcover reductions. -/
theorem exists_isRational_spaOpen_subset [IsRingOfIntegralElements (A⁺ : Subring A)]
    {V : Set ↥(Spa A A⁺)} (hV : IsOpen V) {v : ↥(Spa A A⁺)} (hv : v ∈ V) :
    ∃ D : RationalLocData A, D.IsRational ∧ v ∈ spaOpen D ∧ spaOpen D ⊆ V := by
  obtain ⟨P, π, hA₀le, hπ, hunit⟩ :=
    IsTateRing.exists_principal_pairOfDefinition_le_subring (A := A)
      (IsRingOfIntegralElements.isOpen (B := (A⁺ : Subring A)))
  set I : Ideal A := Ideal.span (P.A₀.subtype '' (P.I : Set P.A₀)) with hI
  have hπI : ∃ π' : A, IsUnit π' ∧ π' ∈ I := by
    refine ⟨(π : A), hunit, ?_⟩
    refine Ideal.subset_span ⟨π, ?_, rfl⟩
    rw [hπ]
    exact Ideal.subset_span rfl
  have htop := spa_topology_eq_generateFrom (A := A) P I hI
  obtain ⟨B, hB, hvB, hBV⟩ :=
    (isTopologicalBasis_of_subbasis htop).exists_subset_of_mem_open hv hV
  obtain ⟨𝒮, ⟨h𝒮fin, h𝒮sub⟩, rfl⟩ := hB
  obtain ⟨D, hDrat, hDeq⟩ := exists_isRational_spaOpen_eq_sInter P hπI 𝒮 h𝒮fin h𝒮sub
  exact ⟨D, hDrat, hDeq ▸ hvB, hDeq ▸ hBV⟩

end ValuationSpectrum
