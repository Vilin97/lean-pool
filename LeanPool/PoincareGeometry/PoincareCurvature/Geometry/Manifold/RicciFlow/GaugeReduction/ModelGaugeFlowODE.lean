    (hβtime : Icc a b ⊆ Icc aβ bβ)
    (htαbase : tα ∈ Ioo a b) (htβbase : tβ ∈ Ioo a b)
    {K : ℝ≥0} {state : ℝ → Set V}
    {x : V} (hxα : x ∈ closedBall xα rα)
    (hyβ : α.flow (x, tβ) ∈ closedBall xβ rβ)
