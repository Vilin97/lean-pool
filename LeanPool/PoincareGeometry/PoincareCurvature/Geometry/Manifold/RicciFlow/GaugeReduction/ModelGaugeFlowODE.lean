        MapsTo (fun y : V => α.flow (y, t)) U W ∧
          InjOn (fun y : V => α.flow (y, t)) U := by
  rcases α.exists_flow_timeSlice_openPartialHomeomorph_of_hasStrictFDerivAt_Ioo
