    {U : Set V} (hU : IsOpen U) (hmem : α.tangent x t v ∈ U) :
    (fun τ : ℝ => α.tangent x τ v) ⁻¹' U ∈ 𝓝 t :=
  (α.tangent_apply_continuousAt_of_mem_Ioo hx ht v) (hU.mem_nhds hmem)

