            ((ofProductContinuousLocalFlowSolution α.toContinuousLocalFlowSolution hball).tangent y t) *
            ‖v‖ := happ
    _ ≤ ((L' : ℝ) * dist x y) * ‖v‖ := by gcongr
    _ = (L' * ‖v‖₊ : ℝ≥0) * dist x y := by
      rw [NNReal.coe_mul, coe_nnnorm]
      ring

