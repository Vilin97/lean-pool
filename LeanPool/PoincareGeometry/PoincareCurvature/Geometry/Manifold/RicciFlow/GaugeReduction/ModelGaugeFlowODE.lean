  let β' : LocalFlowSolution f t₀' xβ rβ :=
    β.restrict hβtime (Ioo_subset_Icc_self htbase) le_rfl
  have htbase' : (t₀' : ℝ) ∈ Ioo a b := by
    simpa [t₀'] using htbase
  have hα_mem' : ∀ t ∈ Ioo a b, α'.flow x t ∈ state t := by
