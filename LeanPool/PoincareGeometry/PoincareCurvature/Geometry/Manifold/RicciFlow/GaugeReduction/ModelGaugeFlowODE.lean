    {t : ℝ} (ht : t ∈ Icc tmin tmax) :
    α.tangent x t v = β.tangent x t v :=
  α.tangent_apply_eqOn_Icc_of_opNorm_bound_of_mem β hxα hxβ ht₀ hflow_eq
    hD_bound v ht

