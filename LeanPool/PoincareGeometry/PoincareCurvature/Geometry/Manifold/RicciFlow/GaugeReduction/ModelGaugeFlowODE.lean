theorem flow_tangent_eq_of_lipschitzOnWith_opNorm_bound_of_mem_Icc
    {xα xβ : V} {rα rβ : ℝ≥0}
    (α : VariationalLocalFlowSolution f Df t₀ xα rα)
    (β : VariationalLocalFlowSolution f Df t₀ xβ rβ)
    {Kf KD : ℝ≥0} {baseState : ℝ → Set V}
