  obtain ⟨Lf, hLf⟩ := ofProduct_flow_exists_lipschitzOnWith_time α hball ht
  obtain ⟨Lv, hLv⟩ :=
    ofProduct_tangent_apply_pair_exists_lipschitzOnWith_time α hball ht u v
