  refine
    model_vectorField_eventuallyEq_mpullbackWithin_of_common_derivatives
      (I := I) (M := M) (Y := Y) (f := f) (s := s) (t := t)
      (γ := fun y τ ↦ (extChartAt I p) (F τ (G t ((extChartAt I p).symm y))))
      p huniq hW ?_ ?_
