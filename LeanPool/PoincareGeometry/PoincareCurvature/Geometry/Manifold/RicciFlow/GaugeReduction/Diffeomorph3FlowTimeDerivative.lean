  · intro y hy
    let q : M := (extChartAt I p).symm y
    let z : M := G t q
    have hqVsrc : q ∈ V ∩ (extChartAt I p).source := by
      simpa [W, q] using hy.2
    have hqV : q ∈ V := hqVsrc.1
    have hqsrcp : q ∈ (extChartAt I p).source := hqVsrc.2
    have hzU : z ∈ U := by
