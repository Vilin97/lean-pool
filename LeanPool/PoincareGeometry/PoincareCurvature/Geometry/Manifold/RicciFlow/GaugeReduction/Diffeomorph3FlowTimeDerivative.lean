/-- The identity `C^3` gauge turns ordinary metric time-regularity into the
named scalar derivative obligation. -/
theorem id_pullbackMetricInnerDerivativeOn
    {g : MetricFamily (I := I) (M := M)}
    {gdot : MetricTensorFamily (I := I) (M := M)}
    {s : Set ℝ}
