        ((Φ τ).pushforwardTangent x v)) =ᶠ[𝓝 t]
      pullbackMetricInnerCoordinateModel (I := I) (M := M) Φ g t x u v := by
  filter_upwards [hmem] with τ hτ
  exact (pullbackMetricInnerCoordinateModel_eq
    (I := I) (M := M) Φ g t τ x u v hτ).symm

