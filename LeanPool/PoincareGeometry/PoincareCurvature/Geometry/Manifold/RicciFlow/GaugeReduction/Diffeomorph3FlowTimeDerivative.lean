      (fun τ : ℝ ↦
        metricBilinearCoordinateField (I := I) (M := M) g p
          (τ, (extChartAt I p) p) uE vE) := by
    filter_upwards [hy] with τ hτ
    rw [hτ]
  exact hcenter.congr_of_eventuallyEq hEq

