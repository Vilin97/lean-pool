  have hu : HasDerivAt (fun τ : ℝ => A τ u) (A' u) t := by
    simpa using hA.clm_apply (hasDerivAt_const (x := t) (c := u))
  have hv : HasDerivAt (fun τ : ℝ => A τ v) (A' v) t := by
    simpa using hA.clm_apply (hasDerivAt_const (x := t) (c := v))
