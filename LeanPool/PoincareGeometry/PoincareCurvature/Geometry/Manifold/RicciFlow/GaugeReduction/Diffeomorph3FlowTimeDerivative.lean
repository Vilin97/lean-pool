            (X t ((G.maps3 t) x))))
      t := by
  let c : ℝ → E := fun τ ↦ (extChartAt I ((G.maps3 t) x)) ((G.maps3 τ) x)
  let B : ℝ → E → E →L[ℝ] E →L[ℝ] ℝ := fun τ yE ↦
