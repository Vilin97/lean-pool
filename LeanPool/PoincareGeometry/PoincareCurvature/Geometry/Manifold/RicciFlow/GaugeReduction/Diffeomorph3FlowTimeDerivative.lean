    (hg : HasTimeDerivativeAt (I := I) (M := M) g gdot t)
    (p : M) {y : ℝ → E}
    (hy : y =ᶠ[𝓝[timeSet] t] fun _ : ℝ ↦ (extChartAt I p) p)
