import LeanPool.MarshallHall.MarshallHall.GrushkoFoldStep

/-!
## Geometric-edge representatives

The terminal graph in the Grushko reduction has one labelled element for
each oriented edge.  Reversal pairs the two orientations, and the subgroup
generated by all oriented labels is therefore already generated by one label
from each geometric edge.  This file packages that finite involution
argument, including the cardinality bound needed to pad a terminal marking
back to its original length.
-/



open Function Monoid.Coprod Quiver

noncomputable section

namespace MarshallHall
namespace GeneralGrushko

universe u v

variable {G H : Type u} [Group G] [Group H]
  {V : Type v} [Fintype V] [Quiver V] [HasInvolutiveReverse V]
  [∀ a b : V, Fintype (a ⟶ b)]

/-! ### A canonical half of a fixed-point-free reversal involution -/

/-- Reversal has no fixed oriented edge.  Rose and fold constructions will
provide this property explicitly; keeping it as a hypothesis avoids silently
identifying a self-reversing quiver arrow with a geometric edge pair. -/
def ReverseFree : Prop :=
  ∀ e : AllArrow (V := V), allArrowReverse e ≠ e

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldReverseFree {a b : V} (e₀ : AllArrow (V := V))
    (hfree : ReverseFree (V := V)) :
    letI : Quiver (foldVertex a b) := foldQuiver e₀
    letI : HasInvolutiveReverse (foldVertex a b) := foldHasReverse e₀
    ReverseFree (V := foldVertex a b) := by
  let : Quiver (foldVertex a b) := foldQuiver e₀
  let : HasInvolutiveReverse (foldVertex a b) := foldHasReverse e₀
  exact fold_allArrow_reverse_ne e₀ hfree

/-- A finite index used to choose one orientation of each geometric edge. -/
noncomputable def allArrowIndex (e : AllArrow (V := V)) :
    Fin (Fintype.card (AllArrow (V := V))) :=
  Fintype.equivFin (AllArrow (V := V)) e

/-- The orientation of each edge with the smaller index than its reverse. -/
def EdgeRepresentative :=
  {e : AllArrow (V := V) //
    (allArrowIndex e).val <
      (allArrowIndex (allArrowReverse e)).val}

noncomputable instance edgeRepresentativeFintype :
    Fintype (EdgeRepresentative (V := V)) := by
  classical
  apply Fintype.subtype (Finset.univ.filter (fun e : AllArrow (V := V) =>
    (allArrowIndex e).val <
      (allArrowIndex (allArrowReverse e)).val))
  intro e
  simp

theorem edgeRepresentative_lt_reverse
    (e : EdgeRepresentative (V := V)) :
    (allArrowIndex e.1).val <
      (allArrowIndex (allArrowReverse e.1)).val :=
  e.2

/-- Chooses the reversed orientation when the given arrow is not the chosen representative. -/
noncomputable def reverseEdgeRepresentative
    (hfree : ReverseFree (V := V)) (e : AllArrow (V := V))
    (hne : ¬ (allArrowIndex e).val <
      (allArrowIndex (allArrowReverse e)).val) :
    EdgeRepresentative (V := V) := by
  refine ⟨allArrowReverse e, ?_⟩
  have hne' : (allArrowIndex (allArrowReverse e)).val ≠
      (allArrowIndex e).val := by
    intro h
    apply hfree e
    apply (Fintype.equivFin (AllArrow (V := V))).injective
    simpa only [allArrowIndex] using Fin.ext h
  have hlt : (allArrowIndex (allArrowReverse e)).val <
      (allArrowIndex e).val := by
    omega
  simpa only [allArrowReverse_reverse] using hlt

/-- The two orientations of a representative. -/
def edgeRepresentativeOrientation
    (e : EdgeRepresentative (V := V)) : Bool → AllArrow (V := V)
  | false => e.1
  | true => allArrowReverse e.1

theorem edgeRepresentativeOrientation_reverse
    (e : EdgeRepresentative (V := V)) (b : Bool) :
    allArrowReverse (edgeRepresentativeOrientation e b) =
      edgeRepresentativeOrientation e (!b) := by
  cases b <;> simp [edgeRepresentativeOrientation]

theorem edgeRepresentativeOrientation_injective
     :
    Function.Injective
      (fun p : EdgeRepresentative (V := V) × Bool =>
        edgeRepresentativeOrientation p.1 p.2) := by
  intro p q hpq
  rcases p with ⟨p, bp⟩
  rcases q with ⟨q, bq⟩
  cases bp <;> cases bq
  · have h : p.1 = q.1 := hpq
    cases p
    cases q
    simp_all
  · exfalso
    have hlt₁ := edgeRepresentative_lt_reverse p
    have hlt₂ := edgeRepresentative_lt_reverse q
    change p.1 = allArrowReverse q.1 at hpq
    have hrev : allArrowReverse q.1 = p.1 := hpq.symm
    have hidx : (allArrowIndex q.1).val < (allArrowIndex p.1).val := by
      simpa only [hrev] using hlt₂
    have hrev' : allArrowReverse p.1 = q.1 := by
      simpa only [allArrowReverse_reverse] using
        (congrArg (allArrowReverse (V := V)) hrev).symm
    have hidx' : (allArrowIndex p.1).val < (allArrowIndex q.1).val := by
      simpa only [hrev'] using hlt₁
    omega
  · exfalso
    have hlt₁ := edgeRepresentative_lt_reverse p
    have hlt₂ := edgeRepresentative_lt_reverse q
    change allArrowReverse p.1 = q.1 at hpq
    have hrev : p.1 = allArrowReverse q.1 := by
      simpa only [allArrowReverse_reverse] using
        congrArg (allArrowReverse (V := V)) hpq
    have hidx : (allArrowIndex p.1).val < (allArrowIndex q.1).val := by
      simpa only [hpq] using hlt₁
    have hidx' : (allArrowIndex q.1).val < (allArrowIndex p.1).val := by
      simpa only [hrev] using hlt₂
    omega
  · have h : allArrowReverse p.1 = allArrowReverse q.1 := hpq
    have h' : p.1 = q.1 := allArrowReverse_injective h
    cases p
    cases q
    simp_all

/-- Identifies oriented arrows with a geometric edge representative and an orientation flag. -/
noncomputable def edgeRepresentativeOrientationEquiv
    (hfree : ReverseFree (V := V)) :
    EdgeRepresentative (V := V) × Bool ≃ AllArrow (V := V) := by
  classical
  apply Equiv.ofBijective
    (fun p : EdgeRepresentative (V := V) × Bool =>
      edgeRepresentativeOrientation p.1 p.2)
  constructor
  · exact edgeRepresentativeOrientation_injective
  · intro e
    by_cases hlt : (allArrowIndex e).val <
        (allArrowIndex (allArrowReverse e)).val
    · refine ⟨(⟨e, hlt⟩, false), ?_⟩
      rfl
    · let er : EdgeRepresentative (V := V) :=
        reverseEdgeRepresentative hfree e hlt
      refine ⟨(er, true), ?_⟩
      change allArrowReverse (allArrowReverse e) = e
      simp

theorem edgeRepresentative_card_mul_two
    (hfree : ReverseFree (V := V)) :
    Fintype.card (EdgeRepresentative (V := V)) * 2 =
      Fintype.card (AllArrow (V := V)) := by
  simpa [Fintype.card_prod] using
    (Fintype.card_congr (edgeRepresentativeOrientationEquiv hfree))

/-! ### Labels of one representative per geometric edge -/

/-- The factor label carried by a chosen geometric edge representative. -/
def edgeRepresentativeLabel
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e : EdgeRepresentative (V := V)) : Sum G H :=
  allArrowLabel L e.1

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem allArrowLabel_reverse
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e : AllArrow (V := V)) :
    allArrowLabel L (allArrowReverse e) =
      factorWordInv (allArrowLabel L e) := by
  change L.label (Quiver.reverse (allArrowHom e)) =
    factorWordInv (L.label (allArrowHom e))
  exact L.reverse_label (allArrowHom e)

theorem edgeRepresentativeLabels_closure_eq_top_of_markedGraph {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    (hfree : ReverseFree (V := V)) (hgen : M.IsGenerating) :
    Subgroup.closure (Set.range (fun e : EdgeRepresentative (V := V) =>
      separatedMap (edgeRepresentativeLabel M.labeling e))) = ⊤ := by
  let R : Subgroup (G ∗ H) := Subgroup.closure (Set.range
    (fun e : EdgeRepresentative (V := V) =>
      separatedMap (edgeRepresentativeLabel M.labeling e)))
  have hle : Subgroup.closure (Set.range (fun e : AllArrow (V := V) =>
      separatedMap (allArrowLabel M.labeling e))) ≤ R := by
    apply (Subgroup.closure_le _).mpr
    rintro z ⟨e, rfl⟩
    by_cases hlt : (allArrowIndex e).val <
        (allArrowIndex (allArrowReverse e)).val
    · exact Subgroup.subset_closure ⟨⟨e, hlt⟩, rfl⟩
    · let er : EdgeRepresentative (V := V) :=
        reverseEdgeRepresentative hfree e hlt
      have hlabel : allArrowLabel M.labeling e =
          factorWordInv (edgeRepresentativeLabel M.labeling er) := by
        change allArrowLabel M.labeling e =
          factorWordInv (allArrowLabel M.labeling (allArrowReverse e))
        rw [allArrowLabel_reverse]
        simp
      change separatedMap (allArrowLabel M.labeling e) ∈ R
      rw [hlabel, separatedMap_factorWordInv]
      exact Subgroup.inv_mem R (Subgroup.subset_closure ⟨er, rfl⟩)
  apply top_unique
  intro z hz
  exact hle ((allArrowLabels_closure_eq_top_of_markedGraph M hgen) ▸ hz)

/-! ### Padding a smaller separated family -/

/-- Extends a shorter list of separated generators by identity labels from the left factor. -/
def padSeparated {m n : ℕ} (s : Fin m → Sum G H) :
    Fin n → Sum G H := fun i =>
  if hi : i.val < m then s ⟨i.val, hi⟩ else Sum.inl 1

omit [Group H] in
theorem padSeparated_contains_original {m n : ℕ} (h : m ≤ n)
    (s : Fin m → Sum G H) (i : Fin m) :
    padSeparated (n := n) s ⟨i.val, lt_of_lt_of_le i.isLt h⟩ = s i := by
  simp [padSeparated]

theorem padSeparated_closure_eq_top {m n : ℕ} (h : m ≤ n)
    (s : Fin m → Sum G H)
    (hs : Subgroup.closure (Set.range (separatedMap ∘ s)) = ⊤) :
    Subgroup.closure (Set.range
      (separatedMap ∘ padSeparated (n := n) s)) = ⊤ := by
  apply top_unique
  intro z hz
  have hle : Subgroup.closure (Set.range (separatedMap ∘ s)) ≤
      Subgroup.closure (Set.range (separatedMap ∘ padSeparated (n := n) s)) := by
    apply (Subgroup.closure_le _).mpr
    rintro y ⟨i, rfl⟩
    refine Subgroup.subset_closure ⟨⟨i.val, lt_of_lt_of_le i.isLt h⟩, ?_⟩
    change separatedMap
      (padSeparated (n := n) s ⟨i.val, lt_of_lt_of_le i.isLt h⟩) =
      separatedMap (s i)
    rw [padSeparated_contains_original h]
  exact hle ((hs ▸ hz))

theorem exists_separated_generators_of_edge_bound {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    (hfree : ReverseFree (V := V)) (hgen : M.IsGenerating)
    (hcard : Fintype.card (AllArrow (V := V)) ≤ 2 * n) :
    ∃ s : Fin n → Sum G H,
      Subgroup.closure (Set.range (separatedMap ∘ s)) = ⊤ := by
  let m := Fintype.card (EdgeRepresentative (V := V))
  have hcardm : m ≤ n := by
    have hpair := edgeRepresentative_card_mul_two hfree
    dsimp [m]
    omega
  let eS : EdgeRepresentative (V := V) ≃ Fin m :=
    Fintype.equivFin (EdgeRepresentative (V := V))
  let s₀ : Fin m → Sum G H := fun i =>
    edgeRepresentativeLabel M.labeling (eS.symm i)
  have hs₀ : Subgroup.closure (Set.range (separatedMap ∘ s₀)) = ⊤ := by
    have hrange : Set.range (separatedMap ∘ s₀) = Set.range
        (fun e : EdgeRepresentative (V := V) =>
          separatedMap (edgeRepresentativeLabel M.labeling e)) := by
      ext z
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨eS.symm i, by rfl⟩
      · rintro ⟨e, rfl⟩
        exact ⟨eS e, by simp [s₀]⟩
    rw [hrange]
    exact edgeRepresentativeLabels_closure_eq_top_of_markedGraph M hfree hgen
  refine ⟨padSeparated s₀, padSeparated_closure_eq_top hcardm s₀ hs₀⟩

theorem exists_separated_generators_of_euler_bound {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    (hfree : ReverseFree (V := V)) (hgen : M.IsGenerating)
    (hVcard : Fintype.card V = 1)
    (hEuler : Fintype.card (AllArrow (V := V)) ≤
      2 * (n + Fintype.card V - 1)) :
    ∃ s : Fin n → Sum G H,
      Subgroup.closure (Set.range (separatedMap ∘ s)) = ⊤ := by
  apply exists_separated_generators_of_edge_bound M hfree hgen
  omega

end GeneralGrushko
end MarshallHall
