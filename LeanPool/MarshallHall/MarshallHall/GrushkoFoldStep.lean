module

public import LeanPool.MarshallHall.MarshallHall.GrushkoGraph
public import Mathlib.Data.Fintype.Card
public import Mathlib.Tactic


/-!
## The finite quotient underlying one graph fold

The graph part of the Grushko argument contracts the two endpoints of a
non-loop and removes the corresponding geometric edge.  This file starts the
construction at the type level.  The path substitution and its label theorem
will be added on top of these finite quotient and deletion primitives.
-/

@[expose] public section



open Function Monoid.Coprod Quiver

noncomputable section

namespace MarshallHall
namespace GeneralGrushko

universe u v

variable {V : Type u} [Fintype V]

/-- The equivalence relation generated by identifying two vertices. -/
def foldSetoid (a b : V) : Setoid V :=
  Relation.EqvGen.setoid (fun x y => x = a ∧ y = b)

noncomputable instance foldQuotientFintype (a b : V) :
    Fintype (Quotient (foldSetoid a b)) := by
  classical
  exact Fintype.ofFinite _

theorem foldQuotient_card_le (a b : V) :
    Fintype.card (Quotient (foldSetoid a b)) ≤ Fintype.card V := by
  classical
  exact Fintype.card_le_of_surjective (Quotient.mk (foldSetoid a b))
    Quotient.mk_surjective

theorem foldQuotient_card_lt {a b : V} (hab : a ≠ b) :
    Fintype.card (Quotient (foldSetoid a b)) < Fintype.card V := by
  classical
  let f : V → Quotient (foldSetoid a b) := Quotient.mk (foldSetoid a b)
  have hsurj : Function.Surjective f := Quotient.mk_surjective
  have hnotinj : ¬ Function.Injective f := by
    intro hinj
    apply hab
    apply hinj
    exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
  exact Fintype.card_lt_of_surjective_not_injective f hsurj hnotinj

/-- Remove both orientations of one geometric edge from a finite oriented
edge type. -/
def deletedEdge (E : Type v) (e₀ e₀' : E) :=
  {e : E // e ≠ e₀ ∧ e ≠ e₀'}

noncomputable instance deletedEdgeFintype (E : Type v) [Fintype E]
    (e₀ e₀' : E) : Fintype (deletedEdge E e₀ e₀') := by
  classical
  change Fintype {e : E // e ≠ e₀ ∧ e ≠ e₀'}
  infer_instance

theorem deletedEdge_card_lt (E : Type v) [Fintype E]
    (e₀ e₀' : E) :
    Fintype.card (deletedEdge E e₀ e₀') < Fintype.card E := by
  classical
  let f : deletedEdge E e₀ e₀' → E := fun e => e.1
  have hinj : Function.Injective f := Subtype.coe_injective
  have hnot_surj : ¬ Function.Surjective f := by
    intro hsurj
    obtain ⟨e, he⟩ := hsurj e₀
    change e.1 = e₀ at he
    exact e.2.1 he
  exact Fintype.card_lt_of_injective_not_surjective f hinj hnot_surj

theorem deletedEdge_card_add_two_le (E : Type v) [Fintype E]
    (e₀ e₀' : E) (hne : e₀ ≠ e₀') :
    Fintype.card (deletedEdge E e₀ e₀') + 2 ≤ Fintype.card E := by
  classical
  let f : deletedEdge E e₀ e₀' ⊕ Fin 2 → E := fun x =>
    match x with
    | Sum.inl e => e.1
    | Sum.inr i => if i = 0 then e₀ else e₀'
  have hinj : Function.Injective f := by
    intro x y h
    cases x with
    | inl x =>
        cases y with
        | inl y =>
            change x.1 = y.1 at h
            exact congrArg Sum.inl (Subtype.ext h)
        | inr j =>
            fin_cases j
            · exact False.elim (x.2.1 h)
            · exact False.elim (x.2.2 h)
    | inr i =>
        cases y with
        | inl y =>
            fin_cases i
            · exact False.elim (y.2.1 h.symm)
            · exact False.elim (y.2.2 h.symm)
        | inr j =>
            fin_cases i <;> fin_cases j
            · rfl
            · exfalso
              change e₀ = e₀' at h
              apply hne
              exact h
            · exfalso
              change e₀' = e₀ at h
              apply hne
              exact h.symm
            · rfl
  have hc := Fintype.card_le_of_injective f hinj
  simpa [f] using hc

theorem deletedEdge_card_add_two_eq (E : Type v) [Fintype E]
    (e₀ e₀' : E) (hne : e₀ ≠ e₀') :
    Fintype.card (deletedEdge E e₀ e₀') + 2 = Fintype.card E := by
  classical
  let f : deletedEdge E e₀ e₀' ⊕ Fin 2 → E := fun x =>
    match x with
    | Sum.inl e => e.1
    | Sum.inr i => if i = 0 then e₀ else e₀'
  have hsurj : Function.Surjective f := by
    intro z
    by_cases hz₀ : z = e₀
    · exact ⟨Sum.inr 0, by simp [f, hz₀]
      ⟩
    by_cases hz₁ : z = e₀'
    · exact ⟨Sum.inr 1, by simp [f, hz₁]
      ⟩
    · exact ⟨Sum.inl ⟨z, hz₀, hz₁⟩, rfl⟩
  have hc : Fintype.card E ≤
      Fintype.card (deletedEdge E e₀ e₀' ⊕ Fin 2) :=
    Fintype.card_le_of_surjective f hsurj
  have hc' : Fintype.card E ≤ Fintype.card (deletedEdge E e₀ e₀') + 2 := by
    simpa [Fintype.card_sum, Fintype.card_fin] using hc
  have hle : Fintype.card (deletedEdge E e₀ e₀') + 2 ≤
      Fintype.card E := deletedEdge_card_add_two_le E e₀ e₀' hne
  exact Nat.le_antisymm hle hc'

/-! ### Oriented edges and the folded quiver -/

variable {G H : Type v} [Group G] [Group H]
  [qV : Quiver V] [hV : HasInvolutiveReverse V]
  [∀ a b : V, Fintype (a ⟶ b)]

/-- The disjoint union of all oriented arrows of a finite quiver. -/
abbrev AllArrow := Σ a b : V, (a ⟶ b)

noncomputable instance allArrowFintype : Fintype (AllArrow (V := V)) := by
  classical
  infer_instance

/-- Packages an arrow together with its source and target. -/
def allArrowOf {a b : V} (e : a ⟶ b) : AllArrow (V := V) := ⟨a, b, e⟩

/-- The source vertex of a packaged arrow. -/
def allArrowSource : AllArrow (V := V) → V
  | ⟨a, _b, _e⟩ => a

/-- The target vertex of a packaged arrow. -/
def allArrowTarget : AllArrow (V := V) → V
  | ⟨_a, b, _e⟩ => b

/-- The underlying arrow between the packaged source and target. -/
def allArrowHom (e : AllArrow (V := V)) :
    allArrowSource e ⟶ allArrowTarget e :=
  e.2.2

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowSource_of {a b : V} (e : a ⟶ b) :
    allArrowSource (allArrowOf e) = a :=
  rfl

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowTarget_of {a b : V} (e : a ⟶ b) :
    allArrowTarget (allArrowOf e) = b :=
  rfl

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowHom_of {a b : V} (e : a ⟶ b) :
    allArrowHom (allArrowOf e) = e :=
  rfl

/-- Reverses an arrow and exchanges its packaged endpoints. -/
def allArrowReverse : AllArrow (V := V) → AllArrow (V := V)
  | ⟨a, b, e⟩ => ⟨b, a, Quiver.reverse e⟩

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowOf_reverse {a b : V} (e : a ⟶ b) :
    allArrowOf (Quiver.reverse e) = allArrowReverse (allArrowOf e) :=
  rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowSource_reverse (e : AllArrow (V := V)) :
    allArrowSource (allArrowReverse e) = allArrowTarget e := by
  cases e
  rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowTarget_reverse (e : AllArrow (V := V)) :
    allArrowTarget (allArrowReverse e) = allArrowSource e := by
  cases e
  rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem allArrowReverse_reverse (e : AllArrow (V := V)) :
    allArrowReverse (allArrowReverse e) = e := by
  cases e
  simp only [allArrowReverse, Quiver.reverse_reverse]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem allArrowReverse_injective : Function.Injective
    (allArrowReverse (V := V)) := by
  intro e₁ e₂ h
  simpa using congrArg (allArrowReverse (V := V)) h

/-- The vertex quotient identifying the two vertices involved in a fold. -/
def foldVertex (a b : V) := Quotient (foldSetoid a b)

noncomputable instance foldVertexFintype (a b : V) : Fintype (foldVertex a b) := by
  change Fintype (Quotient (foldSetoid a b))
  infer_instance

/-- Codes the identified vertices by `none` and every other vertex by its surviving
representative. -/
noncomputable def foldCode (a b v : V) : Option (deletedEdge V a b) := by
  classical
  exact if h : v = a ∨ v = b then none
    else some ⟨v, fun hva => h (Or.inl hva), fun hvb => h (Or.inr hvb)⟩

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
omit [qV : Quiver V] in
theorem foldCode_rel {a b x y : V} (hxy : x = a ∧ y = b) :
    foldCode a b x = foldCode a b y := by
  simp [foldCode, hxy.1, hxy.2]

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
omit [qV : Quiver V] in
theorem foldCode_eq_none_iff {a b v : V} :
    foldCode a b v = none ↔ v = a ∨ v = b := by
  classical
  by_cases h : v = a ∨ v = b <;> simp [foldCode, h]

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
omit [qV : Quiver V] in
theorem foldCode_eq_some_iff {a b v : V} (e : deletedEdge V a b) :
    foldCode a b v = some e ↔ e.1 = v := by
  classical
  by_cases h : v = a ∨ v = b
  · rcases h with rfl | rfl
    · simp [foldCode, e.2.1]
    · simp [foldCode, e.2.2]
  · constructor
    · intro hev
      have hev' :
          (⟨v, fun hva => h (Or.inl hva), fun hvb => h (Or.inr hvb)⟩ :
            deletedEdge V a b) = e := by
        simp only [foldCode, dite_eq_right h] at hev
        exact Option.some.inj hev
      exact (congrArg Subtype.val hev').symm
    · intro hev
      have hve : v ≠ a ∧ v ≠ b := by
        constructor
        · intro hva
          exact h (Or.inl hva)
        · intro hvb
          exact h (Or.inr hvb)
      have hev' :
          (⟨v, hve.1, hve.2⟩ : deletedEdge V a b) = e := by
        apply Subtype.ext
        exact hev.symm
      simp only [foldCode, dite_eq_right h]
      exact congrArg (fun z : deletedEdge V a b => some z) hev'

/-- The vertex code descended to the quotient defining a fold. -/
noncomputable def foldCodeQuotient (a b : V) :
    foldVertex a b → Option (deletedEdge V a b) :=
  Quotient.lift (foldCode a b) (by
    intro x y hxy
    change Relation.EqvGen (fun p q : V => p = a ∧ q = b) x y at hxy
    induction hxy with
    | rel x y h => exact foldCode_rel h
    | refl x => rfl
    | symm x y h ih => exact ih.symm
    | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz)

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
omit [qV : Quiver V] in
@[simp]
theorem foldCodeQuotient_mk (a b v : V) :
    foldCodeQuotient a b (Quotient.mk (foldSetoid a b) v) = foldCode a b v :=
  rfl

/-- Codes the quotient identifying two vertices, allowing the vertices to coincide. -/
noncomputable def foldQuotientCodeEquivGeneral (a b : V) :
    foldVertex a b ≃ Option (deletedEdge V a b) := by
  classical
  apply Equiv.ofBijective (foldCodeQuotient a b)
  constructor
  · intro q r hqr
    revert hqr
    refine Quotient.inductionOn₂ q r ?_
    intro x y hqr
    have hcode : foldCode a b x = foldCode a b y := by
      simpa only [foldCodeQuotient_mk] using hqr
    by_cases hxnone : foldCode a b x = none
    · have hynone : foldCode a b y = none := by
        rw [← hcode, hxnone]
      have hx := (foldCode_eq_none_iff (a := a) (b := b) (v := x)).mp hxnone
      have hy := (foldCode_eq_none_iff (a := a) (b := b) (v := y)).mp hynone
      apply Quotient.sound
      rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
      · exact Relation.EqvGen.refl _
      · exact Relation.EqvGen.rel _ _ ⟨rfl, rfl⟩
      · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨rfl, rfl⟩)
      · exact Relation.EqvGen.refl _
    · cases hxe : foldCode a b x with
      | none => exact False.elim (hxnone hxe)
      | some e =>
          have hye : foldCode a b y = some e := by
            rw [← hcode, hxe]
          have hxval :=
            (foldCode_eq_some_iff (a := a) (b := b) (v := x) e).mp hxe
          have hyval :=
            (foldCode_eq_some_iff (a := a) (b := b) (v := y) e).mp hye
          have hxy : x = y := hxval.symm.trans hyval
          rw [hxy]
  · intro z
    cases z with
    | none =>
        refine ⟨Quotient.mk (foldSetoid a b) a, ?_⟩
        rw [foldCodeQuotient_mk]
        exact (foldCode_eq_none_iff (a := a) (b := b) (v := a)).mpr (Or.inl rfl)
    | some e =>
        refine ⟨Quotient.mk (foldSetoid a b) e.1, ?_⟩
        rw [foldCodeQuotient_mk]
        exact (foldCode_eq_some_iff (a := a) (b := b) (v := e.1) e).mpr rfl

/-- Identifies the folded vertex set with the surviving vertices plus the identified vertex. -/
noncomputable def foldQuotientCodeEquiv {a b : V} (hab : a ≠ b) :
    foldVertex a b ≃ Option (deletedEdge V a b) := by
  exact foldQuotientCodeEquivGeneral a b

omit [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
omit [qV : Quiver V] in
theorem foldQuotient_card_add_one_eq {a b : V} (hab : a ≠ b) :
    Fintype.card (foldVertex a b) + 1 = Fintype.card V := by
  have hq := Fintype.card_congr (foldQuotientCodeEquiv hab)
  have hd := deletedEdge_card_add_two_eq V a b hab
  simp only [Fintype.card_option] at hq
  omega

/-- The arrows surviving deletion of the folded arrow and its reverse. -/
abbrev FoldEdge (e₀ : AllArrow (V := V)) :=
  deletedEdge (AllArrow (V := V)) e₀ (allArrowReverse e₀)

/-- The canonical map from original vertices to folded vertices. -/
def foldVertexMk {a b : V} (v : V) : foldVertex a b :=
  Quotient.mk (foldSetoid a b) v

/-- The source of a surviving arrow in the folded vertex quotient. -/
def foldEdgeSource {a b : V} (e₀ : AllArrow (V := V))
    (e : FoldEdge e₀) : foldVertex a b :=
  foldVertexMk (a := a) (b := b) (allArrowSource e.1)

/-- The target of a surviving arrow in the folded vertex quotient. -/
def foldEdgeTarget {a b : V} (e₀ : AllArrow (V := V))
    (e : FoldEdge e₀) : foldVertex a b :=
  foldVertexMk (a := a) (b := b) (allArrowTarget e.1)

/-- The quiver on folded vertices whose arrows are the surviving original arrows. -/
@[reducible]
def foldQuiver {a b : V} (e₀ : AllArrow (V := V)) :
    Quiver (foldVertex a b) where
  Hom x y := {e : FoldEdge e₀ //
    foldEdgeSource e₀ e = x ∧ foldEdgeTarget e₀ e = y}

/-- A finite enumeration of arrows between two vertices in the folded quiver. -/
@[instance_reducible]
noncomputable def foldQuiverHomFintype {a b : V}
    (e₀ : AllArrow (V := V)) (x y : foldVertex a b) :
    Fintype (@Quiver.Hom (foldVertex a b) (foldQuiver e₀) x y) := by
  classical
  change Fintype {e : FoldEdge e₀ //
    foldEdgeSource e₀ e = x ∧ foldEdgeTarget e₀ e = y}
  infer_instance

noncomputable instance foldAllArrowFintype {a b : V}
    (e₀ : AllArrow (V := V)) :
    Fintype (@AllArrow (foldVertex a b) (foldQuiver e₀)) := by
  letI : Fintype (foldVertex a b) := foldVertexFintype a b
  letI : Quiver (foldVertex a b) := foldQuiver e₀
  letI (x y : foldVertex a b) : Fintype (x ⟶ y) := by
    exact foldQuiverHomFintype e₀ x y
  exact allArrowFintype

/-! ### Oriented-edge bookkeeping for a fold -/

/-- Forgets the quotient endpoints of a folded arrow and recovers its original arrow. -/
def foldAllArrowToAllArrow {a b : V} (e₀ : AllArrow (V := V)) :
    @AllArrow (foldVertex a b) (foldQuiver e₀) → AllArrow (V := V) :=
  fun e => e.2.2.1.1

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldAllArrowToAllArrow_injective {a b : V}
    (e₀ : AllArrow (V := V)) :
    Function.Injective (foldAllArrowToAllArrow (a := a) (b := b) e₀) := by
  intro e₁ e₂ h
  have hd : e₁.2.2.1 = e₂.2.2.1 := by
    apply Subtype.ext
    exact h
  have hx : e₁.1 = e₂.1 := by
    calc
      e₁.1 = foldEdgeSource e₀ e₁.2.2.1 := e₁.2.2.2.1.symm
      _ = foldEdgeSource e₀ e₂.2.2.1 := congrArg (foldEdgeSource e₀) hd
      _ = e₂.1 := e₂.2.2.2.1
  have hy : e₁.2.1 = e₂.2.1 := by
    calc
      e₁.2.1 = foldEdgeTarget e₀ e₁.2.2.1 := e₁.2.2.2.2.symm
      _ = foldEdgeTarget e₀ e₂.2.2.1 := congrArg (foldEdgeTarget e₀) hd
      _ = e₂.2.1 := e₂.2.2.2.2
  cases e₁ with
  | mk x₁ be₁ =>
    cases be₁ with
    | mk y₁ f₁ =>
      cases e₂ with
      | mk x₂ be₂ =>
        cases be₂ with
        | mk y₂ f₂ =>
          simp only at hx hy
          subst x₂
          subst y₂
          have hf : f₁ = f₂ := by
            apply Subtype.ext
            exact hd
          cases hf
          rfl

/-- Identifies a folded arrow with an original arrow outside the deleted reversal pair. -/
def foldAllArrowToDeletedEdge {a b : V} (e₀ : AllArrow (V := V)) :
    @AllArrow (foldVertex a b) (foldQuiver e₀) →
      deletedEdge (AllArrow (V := V)) e₀ (allArrowReverse e₀) :=
  fun e => ⟨e.2.2.1.1, e.2.2.1.2.1, e.2.2.1.2.2⟩

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldAllArrowToDeletedEdge_injective {a b : V}
    (e₀ : AllArrow (V := V)) :
    Function.Injective (foldAllArrowToDeletedEdge (a := a) (b := b) e₀) := by
  intro e₁ e₂ h
  apply foldAllArrowToAllArrow_injective e₀
  exact congrArg Subtype.val h

theorem foldAllArrow_card_le {a b : V} (e₀ : AllArrow (V := V)) :
    Fintype.card (@AllArrow (foldVertex a b) (foldQuiver e₀)) ≤
      Fintype.card (AllArrow (V := V)) := by
  let (x y : foldVertex a b) :
      Fintype (@Quiver.Hom (foldVertex a b) (foldQuiver e₀) x y) :=
    foldQuiverHomFintype e₀ x y
  exact Fintype.card_le_of_injective
    (foldAllArrowToAllArrow (a := a) (b := b) e₀)
    (foldAllArrowToAllArrow_injective e₀)

theorem foldAllArrow_card_add_two_le {a b : V} (e₀ : AllArrow (V := V))
    (hfree : allArrowReverse e₀ ≠ e₀) :
    Fintype.card (@AllArrow (foldVertex a b) (foldQuiver e₀)) + 2 ≤
      Fintype.card (AllArrow (V := V)) := by
  have hfold : Fintype.card (@AllArrow (foldVertex a b) (foldQuiver e₀)) ≤
      Fintype.card (deletedEdge (AllArrow (V := V)) e₀ (allArrowReverse e₀)) := by
    exact Fintype.card_le_of_injective
      (foldAllArrowToDeletedEdge (a := a) (b := b) e₀)
      (foldAllArrowToDeletedEdge_injective e₀)
  have hdel := deletedEdge_card_add_two_le
    (AllArrow (V := V)) e₀ (allArrowReverse e₀)
    (fun h => hfree h.symm)
  omega

/-- Reverses a surviving arrow in the folded quiver. -/
def foldReverseArrow {a b : V} (e₀ : AllArrow (V := V)) {x y : foldVertex a b}
    (e : @Quiver.Hom (foldVertex a b) (foldQuiver e₀) x y) :
    @Quiver.Hom (foldVertex a b) (foldQuiver e₀) y x := by
  have he0 : allArrowReverse e.1.1 ≠ e₀ := by
    intro h
    apply e.1.2.2
    calc
      e.1.1 = allArrowReverse (allArrowReverse e.1.1) :=
        (allArrowReverse_reverse e.1.1).symm
      _ = allArrowReverse e₀ := congrArg (allArrowReverse (V := V)) h
  have her : allArrowReverse e.1.1 ≠ allArrowReverse e₀ := by
    intro h
    apply e.1.2.1
    simpa using congrArg (allArrowReverse (V := V)) h
  refine ⟨⟨allArrowReverse e.1.1, he0, her⟩, ?_, ?_⟩
  · change foldVertexMk (allArrowSource (allArrowReverse e.1.1)) = y
    rw [allArrowSource_reverse]
    exact e.2.2
  · change foldVertexMk (allArrowTarget (allArrowReverse e.1.1)) = x
    rw [allArrowTarget_reverse]
    exact e.2.1

/-- The involutive reversal operation inherited by the folded quiver. -/
@[instance_reducible]
def foldHasReverse {a b : V} (e₀ : AllArrow (V := V)) :
    @Quiver.HasInvolutiveReverse (foldVertex a b)
      (foldQuiver (V := V) (a := a) (b := b) e₀) :=
  @Quiver.HasInvolutiveReverse.mk
    (foldVertex a b)
    (foldQuiver (V := V) (a := a) (b := b) e₀)
    (@Quiver.HasReverse.mk
      (foldVertex a b)
      (foldQuiver (V := V) (a := a) (b := b) e₀)
      (fun {x y} e =>
        foldReverseArrow (V := V) (a := a) (b := b) e₀ e))
    (by
      intro x y e
      apply Subtype.ext
      apply Subtype.ext
      exact allArrowReverse_reverse e.1.1)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem fold_allArrow_reverse_ne {a b : V} (e₀ : AllArrow (V := V))
    (hfree : ∀ e : AllArrow (V := V), allArrowReverse e ≠ e) :
    letI : Quiver (foldVertex a b) := foldQuiver e₀
    letI : HasInvolutiveReverse (foldVertex a b) := foldHasReverse e₀
    ∀ e : AllArrow (V := foldVertex a b), allArrowReverse e ≠ e := by
  let : Quiver (foldVertex a b) := foldQuiver e₀
  let : HasInvolutiveReverse (foldVertex a b) := foldHasReverse e₀
  intro e he
  apply hfree (foldAllArrowToAllArrow (a := a) (b := b) e₀ e)
  have he' := congrArg (foldAllArrowToAllArrow (a := a) (b := b) e₀) he
  change allArrowReverse (foldAllArrowToAllArrow (a := a) (b := b) e₀ e) =
      foldAllArrowToAllArrow (a := a) (b := b) e₀ e at he'
  exact he'

/-- Reads the factor label of a packaged arrow. -/
def allArrowLabel (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e : AllArrow (V := V)) : Sum G H :=
  L.label (allArrowHom e)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem pathRead_mem_closure_allArrowLabels
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    {a b : V} (p : @Quiver.Path V qV a b) :
    L.pathRead p ∈
      Subgroup.closure (Set.range (fun e : AllArrow (V := V) =>
        separatedMap (allArrowLabel L e))) := by
  induction p with
  | nil =>
      exact Subgroup.one_mem _
  | cons p e ih =>
      rw [← Path.comp_toPath_eq_cons, L.pathRead_comp,
        L.pathRead_toPath]
      apply Subgroup.mul_mem _ ih
      apply Subgroup.subset_closure
      exact ⟨allArrowOf e, rfl⟩

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem allArrowLabels_closure_eq_top_of_markedGraph {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    (hgen : M.IsGenerating) :
    Subgroup.closure (Set.range (fun e : AllArrow (V := V) =>
      separatedMap (allArrowLabel M.labeling e))) = ⊤ := by
  apply top_unique
  intro x hx
  have hx' : x ∈ Subgroup.closure (Set.range M.read) := by
    rw [hgen]
    trivial
  have hle : Subgroup.closure (Set.range M.read) ≤
      Subgroup.closure (Set.range (fun e : AllArrow (V := V) =>
        separatedMap (allArrowLabel M.labeling e))) := by
    apply (Subgroup.closure_le _).mpr
    rintro y ⟨i, rfl⟩
    change M.labeling.pathRead (M.loops i) ∈ _
    exact pathRead_mem_closure_allArrowLabels M.labeling (M.loops i)
  exact hle hx'

theorem exists_separated_generators_of_markedGraph {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    (hgen : M.IsGenerating) :
    ∃ s : Fin (Fintype.card (AllArrow (V := V))) → Sum G H,
      Subgroup.closure (Set.range (separatedMap ∘ s)) = ⊤ := by
  classical
  let eS : AllArrow (V := V) ≃ Fin (Fintype.card (AllArrow (V := V))) :=
    Fintype.equivFin (AllArrow (V := V))
  let s : Fin (Fintype.card (AllArrow (V := V))) → Sum G H :=
    fun i => allArrowLabel M.labeling (eS.symm i)
  refine ⟨s, ?_⟩
  have hrange : Set.range (separatedMap ∘ s) =
      Set.range (fun e : AllArrow (V := V) =>
        separatedMap (allArrowLabel M.labeling e)) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨eS.symm i, by rfl⟩
    · rintro ⟨e, rfl⟩
      exact ⟨eS e, by simp [s]⟩
  rw [hrange]
  exact allArrowLabels_closure_eq_top_of_markedGraph M hgen

/-- The original factor labelling restricted to the arrows surviving a fold. -/
def foldLabelling (L : BinaryLabelling (G := G) (H := H) (V := V))
    {a b : V} (e₀ : AllArrow (V := V)) :
      @BinaryLabelling G H (foldVertex a b) _ _
      (foldQuiver (V := V) (a := a) (b := b) e₀)
      (foldHasReverse (a := a) (b := b) e₀) := by
  exact @BinaryLabelling.mk G H (foldVertex a b) _ _
    (foldQuiver (V := V) (a := a) (b := b) e₀)
    (foldHasReverse (a := a) (b := b) e₀)
    (fun {x y} e => allArrowLabel L e.1.1)
    (by
      intro x y e
      change L.label (Quiver.reverse (allArrowHom e.1.1)) =
        factorWordInv (L.label (allArrowHom e.1.1))
      exact L.reverse_label (allArrowHom e.1.1))

/-! ### Substitution of the deleted edge by a complementary path -/

/-- A path avoids the two orientations of the edge being deleted. -/
def foldPathAvoid (e₀ : AllArrow (V := V)) :
    ∀ {x y : V}, @Quiver.Path V _ x y → Prop
  | _, _, Path.nil => True
  | _, _, Path.cons p e =>
      foldPathAvoid e₀ p ∧ allArrowOf e ≠ e₀ ∧
        allArrowOf e ≠ allArrowReverse e₀

/-- Maps an original arrow outside the deleted pair to its folded arrow. -/
def foldOrdinaryEdge {a b : V} (e₀ : AllArrow (V := V))
    {x y : V} (e : x ⟶ y) (he₀ : allArrowOf e ≠ e₀)
    (her : allArrowOf e ≠ allArrowReverse e₀) :
    @Quiver.Hom (foldVertex a b) (foldQuiver e₀)
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y) :=
  ⟨⟨allArrowOf e, he₀, her⟩, rfl, rfl⟩

/-- Maps a path avoiding the deleted reversal pair into the folded quiver. -/
def foldOrdinaryPath {a b : V} (e₀ : AllArrow (V := V)) :
    ∀ {x y : V} (p : @Quiver.Path V _ x y),
      foldPathAvoid e₀ p →
        @Quiver.Path (foldVertex a b) (foldQuiver e₀)
          (foldVertexMk (a := a) (b := b) x)
          (foldVertexMk (a := a) (b := b) y)
  | _, _, Path.nil, _ =>
      @Quiver.Path.nil (foldVertex a b) (foldQuiver e₀) _
  | _, _, Path.cons p e, hp =>
      by
        have hp' : foldPathAvoid e₀ p ∧ allArrowOf e ≠ e₀ ∧
            allArrowOf e ≠ allArrowReverse e₀ := by
          simpa [foldPathAvoid] using hp
        exact @Quiver.Path.cons (foldVertex a b) (foldQuiver e₀)
          (foldVertexMk (a := a) (b := b) _) _
          (foldVertexMk (a := a) (b := b) _)
          (foldOrdinaryPath (a := a) (b := b) e₀ p hp'.1)
          (foldOrdinaryEdge (a := a) (b := b) e₀ e hp'.2.1 hp'.2.2)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldPathAvoid_comp (e₀ : AllArrow (V := V))
    {x y z : V} (p : @Quiver.Path V _ x y)
    (q : @Quiver.Path V _ y z) :
    foldPathAvoid e₀ (p.comp q) ↔
      foldPathAvoid e₀ p ∧ foldPathAvoid e₀ q := by
  induction q with
  | nil => simp [foldPathAvoid]
  | cons q e ih =>
      simp only [Path.comp_cons, foldPathAvoid, ih, and_assoc]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldPathAvoid_reverse (e₀ : AllArrow (V := V))
    {x y : V} (p : @Quiver.Path V _ x y) (hp : foldPathAvoid e₀ p) :
    foldPathAvoid e₀ p.reverse := by
  induction p with
  | nil => trivial
  | cons p e ih =>
      rw [Path.reverse, foldPathAvoid_comp]
      have hp' : foldPathAvoid e₀ p ∧ allArrowOf e ≠ e₀ ∧
          allArrowOf e ≠ allArrowReverse e₀ := by
        simpa [foldPathAvoid] using hp
      refine ⟨?_, ih hp'.1⟩
      have havoid : allArrowOf (Quiver.reverse e) ≠ e₀ ∧
          allArrowOf (Quiver.reverse e) ≠ allArrowReverse e₀ := by
        constructor
        · intro h
          apply hp'.2.2
          apply allArrowReverse_injective
          calc
            allArrowReverse (allArrowOf e) = allArrowOf (Quiver.reverse e) := by
              rw [allArrowOf_reverse]
            _ = e₀ := h
            _ = allArrowReverse (allArrowReverse e₀) :=
              (allArrowReverse_reverse e₀).symm
        · intro h
          apply hp'.2.1
          apply allArrowReverse_injective
          simpa only [allArrowOf_reverse] using h
      simpa only [Quiver.Hom.toPath, foldPathAvoid] using
        (show True ∧ allArrowOf (Quiver.reverse e) ≠ e₀ ∧
            allArrowOf (Quiver.reverse e) ≠ allArrowReverse e₀ from
          ⟨True.intro, havoid.1, havoid.2⟩)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldOrdinaryPath_labels {a b : V} (L : BinaryLabelling (G := G)
    (H := H) (V := V)) (e₀ : AllArrow (V := V))
    {x y : V} (p : @Quiver.Path V _ x y) (hp : foldPathAvoid e₀ p) :
    (@BinaryLabelling.pathLabels G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀)
      _ _
      (foldOrdinaryPath e₀ p hp)) =
      L.pathLabels p := by
  induction p with
  | nil => simp only [foldOrdinaryPath, BinaryLabelling.pathLabels]
  | cons p e ih =>
      have hp' : foldPathAvoid e₀ p ∧ allArrowOf e ≠ e₀ ∧
          allArrowOf e ≠ allArrowReverse e₀ := by
        simpa [foldPathAvoid] using hp
      simp only [foldOrdinaryPath, BinaryLabelling.pathLabels]
      rw [ih hp'.1]
      rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldOrdinaryPath_read {a b : V} (L : BinaryLabelling (G := G)
    (H := H) (V := V)) (e₀ : AllArrow (V := V))
    {x y : V} (p : @Quiver.Path V _ x y) (hp : foldPathAvoid e₀ p) :
    (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀)
      _ _
      (foldOrdinaryPath e₀ p hp)) = L.pathRead p := by
  simp only [BinaryLabelling.pathRead, foldOrdinaryPath_labels L e₀ p hp]

/-- Replace the deleted edge by a complementary path.  The path `q` runs
from the target of the chosen edge back to its source, so `q.reverse` is the
replacement for the chosen orientation and `q` is the replacement for its
reverse. -/
def foldEdgePath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a) {x y : V} (e : x ⟶ y)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q) :
    @Quiver.Path (foldVertex a b) (foldQuiver e₀)
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y) := by
  classical
  by_cases h : allArrowOf e = e₀
  · have hs : x = allArrowSource e₀ := by
      exact congrArg allArrowSource h
    have ht : y = allArrowTarget e₀ := by
      exact congrArg allArrowTarget h
    have hident :
        foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
          foldVertexMk (a := a) (b := b) b := by
      calc
        foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
            foldVertexMk (a := a) (b := b) a := congrArg _ ha
        _ = foldVertexMk (a := a) (b := b) b := by
          exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
    exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
      (foldVertexMk (a := a) (b := b) b)
      (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y)
      (hident.symm.trans
        (congrArg (foldVertexMk (a := a) (b := b)) hs.symm))
      (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)
      (foldOrdinaryPath (a := a) (b := b) e₀ q.reverse
        (foldPathAvoid_reverse e₀ q hq))
  · by_cases h' : allArrowOf e = allArrowReverse e₀
    · have hs : x = allArrowTarget e₀ := by
        exact congrArg allArrowSource h'
      have ht : y = allArrowSource e₀ := by
        exact congrArg allArrowTarget h'
      exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
        (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
        (foldVertexMk (a := a) (b := b) b)
        (foldVertexMk (a := a) (b := b) x)
        (foldVertexMk (a := a) (b := b) y)
        (congrArg (foldVertexMk (a := a) (b := b)) hs.symm)
        ((by
          have hident :
              foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                foldVertexMk (a := a) (b := b) b := by
            calc
              foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                  foldVertexMk (a := a) (b := b) a := congrArg _ ha
              _ = foldVertexMk (a := a) (b := b) b := by
                exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
          exact hident.symm.trans
            (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)))
        (foldOrdinaryPath (a := a) (b := b) e₀ q hq)
    · exact @Quiver.Hom.toPath (foldVertex a b) (foldQuiver e₀) _ _
        (foldOrdinaryEdge (a := a) (b := b) e₀ e h h')

/-- Maps arbitrary paths through a fold by replacing the deleted arrow with the specified detour. -/
def foldMapPath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q) :
    ∀ {x y : V}, @Quiver.Path V _ x y →
      @Quiver.Path (foldVertex a b) (foldQuiver e₀)
        (foldVertexMk (a := a) (b := b) x)
        (foldVertexMk (a := a) (b := b) y)
  | _, _, Path.nil =>
      @Quiver.Path.nil (foldVertex a b) (foldQuiver e₀) _
  | _, _, Path.cons p e =>
      @Quiver.Path.comp (foldVertex a b) (foldQuiver e₀) _ _ _
        (foldMapPath e₀ ha q hq p)
        (foldEdgePath e₀ ha e q hq)

/-- Maps a symmetrized arrow through a fold using the replacement detour in the appropriate
orientation. -/
def foldSymmArrowPath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q) {x y : V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V _)
      x y) :
    @Quiver.Path (Symmetrify (foldVertex a b))
      (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y) := by
  cases e with
  | inl f =>
      exact @Prefunctor.mapPath (foldVertex a b) (foldQuiver e₀)
        (Symmetrify (foldVertex a b))
        (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
        (@Quiver.Symmetrify.of (foldVertex a b) (foldQuiver e₀)) _ _
        (foldEdgePath e₀ ha f q hq)
  | inr f =>
      exact @Quiver.Path.reverse (Symmetrify (foldVertex a b))
        (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
        inferInstance _ _
        (@Prefunctor.mapPath (foldVertex a b) (foldQuiver e₀)
          (Symmetrify (foldVertex a b))
          (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
          (@Quiver.Symmetrify.of (foldVertex a b) (foldQuiver e₀)) _ _
          (foldEdgePath e₀ ha f q hq))

/-- Extends the fold map from symmetrized arrows to symmetrized paths. -/
def foldSymmPath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q) :
    ∀ {x y : Symmetrify V},
      @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y →
      @Quiver.Path (Symmetrify (foldVertex a b))
        (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
        (foldVertexMk (a := a) (b := b) x)
        (foldVertexMk (a := a) (b := b) y)
  | _, _, Path.nil =>
      @Quiver.Path.nil (Symmetrify (foldVertex a b))
        (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀)) _
  | _, _, Path.cons p e =>
      @Quiver.Path.comp (Symmetrify (foldVertex a b))
        (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀)) _ _ _
        (foldSymmPath e₀ ha q hq p)
        (foldSymmArrowPath e₀ ha q hq e)

/-! ### The same construction for paths that use either orientation -/

/-- Forgets the formal orientation of a symmetrized arrow and records its underlying original
arrow. -/
def symmAllArrow {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    AllArrow (V := V) :=
  match e with
  | Sum.inl f => allArrowOf f
  | Sum.inr f => allArrowOf f

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmAllArrow_inl {x y : Symmetrify V} (f : x ⟶ y) :
    symmAllArrow (Sum.inl f) = allArrowOf f :=
  rfl

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmAllArrow_inr {x y : Symmetrify V} (f : y ⟶ x) :
    symmAllArrow (Sum.inr f) = allArrowOf f :=
  rfl

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
theorem symmAllArrow_reverse {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    symmAllArrow (Quiver.reverse e) = symmAllArrow e := by
  cases e <;> rfl

/-- The oriented graph edge represented by a symmetrized arrow.  Unlike
`symmAllArrow`, this remembers whether the arrow is forward or backward. -/
@[reducible]
def symmOrientedArrow {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    AllArrow (V := V) :=
  match e with
  | Sum.inl f => allArrowOf f
  | Sum.inr f => allArrowReverse (allArrowOf f)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmOrientedArrow_source {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    allArrowSource (symmOrientedArrow e) = (show V from x) := by
  cases e <;> rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmOrientedArrow_target {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    allArrowTarget (symmOrientedArrow e) = (show V from y) := by
  cases e <;> rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem symmAllArrow_eq_oriented_or_reverse {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    symmAllArrow e = symmOrientedArrow e ∨
      symmAllArrow e = allArrowReverse (symmOrientedArrow e) := by
  cases e with
  | inl f => exact Or.inl rfl
  | inr f =>
      right
      change allArrowOf f =
        allArrowReverse (allArrowReverse (allArrowOf f))
      rw [allArrowReverse_reverse]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem symmLabel_eq_allArrowLabel_oriented
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    L.symmLabel e = allArrowLabel L (symmOrientedArrow e) := by
  cases e with
  | inl f => rfl
  | inr f =>
      change factorWordInv (L.label f) = L.label (Quiver.reverse f)
      exact (L.reverse_label f).symm

/-- A symmetrized path avoids both orientations of the deleted edge. -/
def foldSymmPathAvoid (e₀ : AllArrow (V := V)) :
    ∀ {x y : Symmetrify V},
      @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y → Prop
  | _, _, Path.nil => True
  | _, _, Path.cons p e =>
      foldSymmPathAvoid e₀ p ∧ symmAllArrow e ≠ e₀ ∧
        symmAllArrow e ≠ allArrowReverse e₀

/-! ### Edge-simple paths are automatically safe to fold -/

/-- The underlying geometric edges traversed by a symmetrized path.  The
orientation is deliberately forgotten, so an edge and its reverse have the
same entry. -/
def symmPathEdges {a : Symmetrify V} :
    ∀ {b : Symmetrify V},
      @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b →
        List (AllArrow (V := V))
  | _, Path.nil => []
  | _, Path.cons p e => symmPathEdges p ++ [symmAllArrow e]

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmPathEdges_nil {a : Symmetrify V} :
    symmPathEdges (qV := qV)
      (@Quiver.Path.nil (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a) = [] :=
  rfl

omit [Fintype V] [hV : Quiver.HasInvolutiveReverse V] [(a b : V) → Fintype (a ⟶ b)] in
@[simp]
theorem symmPathEdges_toPath {a b : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b) :
    symmPathEdges (qV := qV) e.toPath = [symmAllArrow e] := by
  rfl

omit [Fintype V] hV [(a b : V) → Fintype (a ⟶ b)] in
theorem symmPathEdges_comp {a b : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b) :
    ∀ {c : Symmetrify V}
      (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) b c),
      symmPathEdges (qV := qV) (p.comp q) =
        symmPathEdges (qV := qV) p ++ symmPathEdges (qV := qV) q
  | _, Path.nil => by simp
  | _, Path.cons q e => by
      simp only [Path.comp_cons, symmPathEdges]
      rw [symmPathEdges_comp p q, List.append_assoc]

/-- A path is geometrically simple when it never repeats an edge in either orientation. -/
def GeometricallySimple {a b : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b) : Prop :=
  (symmPathEdges (qV := qV) p).Pairwise (fun e f =>
    e ≠ f ∧ e ≠ allArrowReverse f)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
/-- A geometrically simple path avoids its initial edge and reverse in the remaining tail. -/
theorem foldSymmPathAvoid_of_geometricallySimple_general
    {a c b : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b)
    (hsimple : GeometricallySimple (qV := qV) (e.toPath.comp q)) :
    foldSymmPathAvoid (symmOrientedArrow e) q := by
  classical
  let e₀ := symmOrientedArrow e
  have hsimple' : List.Pairwise (fun x y : AllArrow (V := V) =>
      x ≠ y ∧ x ≠ allArrowReverse y)
      (symmAllArrow e :: symmPathEdges (qV := qV) q) := by
    change List.Pairwise (fun x y : AllArrow (V := V) =>
      x ≠ y ∧ x ≠ allArrowReverse y)
      (symmPathEdges (qV := qV) (e.toPath.comp q)) at hsimple
    rw [symmPathEdges_comp, symmPathEdges_toPath] at hsimple
    simpa using hsimple
  have hfirst : ∀ z ∈ symmPathEdges (qV := qV) q,
      symmAllArrow e ≠ z ∧ symmAllArrow e ≠ allArrowReverse z := by
    intro z hz
    exact (List.pairwise_cons.mp hsimple').1 z hz
  have hfirst' : ∀ z ∈ symmPathEdges (qV := qV) q,
      z ≠ e₀ ∧ z ≠ allArrowReverse e₀ := by
    intro z hz
    change z ≠ symmOrientedArrow e ∧
      z ≠ allArrowReverse (symmOrientedArrow e)
    have h := hfirst z hz
    have hor := symmAllArrow_eq_oriented_or_reverse (qV := qV) e
    constructor
    · intro hz₀
      rcases hor with hor | hor
      · exact h.1 (hor.trans hz₀.symm)
      · exact h.2 (hor.trans (congrArg (allArrowReverse (V := V)) hz₀).symm)
    · intro hz₀
      rcases hor with hor | hor
      · apply h.2
        calc
          symmAllArrow e = symmOrientedArrow e := hor
          _ = allArrowReverse (allArrowReverse (symmOrientedArrow e)) :=
            (allArrowReverse_reverse (symmOrientedArrow e)).symm
          _ = allArrowReverse z := by rw [hz₀]
      · apply h.1
        exact hor.trans hz₀.symm
  have havoid_aux : ∀ {x y : Symmetrify V}
      (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y),
      (∀ z ∈ symmPathEdges (qV := qV) p,
        z ≠ e₀ ∧ z ≠ allArrowReverse e₀) →
      foldSymmPathAvoid e₀ p := by
    intro x y p
    induction p with
    | nil =>
        intro _
        simp [foldSymmPathAvoid]
    | cons p f ih =>
        intro hp
        have htail : ∀ z ∈ symmPathEdges (qV := qV) p,
            z ≠ e₀ ∧ z ≠ allArrowReverse e₀ := by
          intro z hz
          apply hp z
          simp [symmPathEdges, hz]
        have hf : symmAllArrow f ≠ e₀ ∧
            symmAllArrow f ≠ allArrowReverse e₀ := by
          apply hp
          simp [symmPathEdges]
        simpa [foldSymmPathAvoid] using ⟨ih htail, hf.1, hf.2⟩
  apply havoid_aux q
  intro z hz
  exact hfirst' z hz

omit [Fintype V] in
omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmPathAvoid_of_geometricallySimple [Finite V]
    {a c b : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b)
    (hsimple : GeometricallySimple (qV := qV) (e.toPath.comp q)) :
    foldSymmPathAvoid (symmOrientedArrow e) q := by
  exact foldSymmPathAvoid_of_geometricallySimple_general e q hsimple

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmPathAvoid_cast {e₀ : AllArrow (V := V)}
    {x y x' y' : Symmetrify V} (hx : x = x') (hy : y = y')
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    foldSymmPathAvoid e₀ (p.cast hx hy) ↔ foldSymmPathAvoid e₀ p := by
  subst_vars
  rfl

/-- Maps a symmetrized arrow outside the deleted reversal pair into the folded quiver. -/
def foldSymmOrdinaryArrowPath {a b : V} (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (he₀ : symmAllArrow e ≠ e₀)
    (her : symmAllArrow e ≠ allArrowReverse e₀) :
    @Quiver.Path (foldVertex a b) (foldQuiver e₀)
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y) := by
  cases e with
  | inl f =>
      exact @Quiver.Hom.toPath (foldVertex a b) (foldQuiver e₀) _ _
        (foldOrdinaryEdge (a := a) (b := b) e₀ f he₀ her)
  | inr f =>
      exact @Quiver.Path.reverse (foldVertex a b) (foldQuiver e₀)
        (foldHasReverse e₀).toHasReverse _ _
        (@Quiver.Hom.toPath (foldVertex a b) (foldQuiver e₀) _ _
          (foldOrdinaryEdge (a := a) (b := b) e₀ f he₀ her))

/-- Maps a symmetrized path avoiding the deleted reversal pair into the folded quiver. -/
def foldSymmOrdinaryPath {a b : V} (e₀ : AllArrow (V := V)) :
    ∀ {x y : Symmetrify V}
      (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y),
      foldSymmPathAvoid e₀ p →
        @Quiver.Path (foldVertex a b) (foldQuiver e₀)
          (foldVertexMk (a := a) (b := b) x)
          (foldVertexMk (a := a) (b := b) y)
  | _, _, Path.nil, _ =>
      @Quiver.Path.nil (foldVertex a b) (foldQuiver e₀) _
  | _, _, Path.cons p e, hp =>
      by
        have hp' : foldSymmPathAvoid e₀ p ∧ symmAllArrow e ≠ e₀ ∧
            symmAllArrow e ≠ allArrowReverse e₀ := by
          simpa [foldSymmPathAvoid] using hp
        exact @Quiver.Path.comp (foldVertex a b) (foldQuiver e₀) _ _ _
          (foldSymmOrdinaryPath e₀ p hp'.1)
          (foldSymmOrdinaryArrowPath e₀ e hp'.2.1 hp'.2.2)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmPathAvoid_comp (e₀ : AllArrow (V := V))
    {x y z : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) y z) :
    foldSymmPathAvoid e₀ (p.comp q) ↔
      foldSymmPathAvoid e₀ p ∧ foldSymmPathAvoid e₀ q := by
  induction q with
  | nil =>
      rw [Path.comp_nil]
      constructor
      · intro hp
        exact ⟨hp, by simp [foldSymmPathAvoid]⟩
      · rintro ⟨hp, _⟩
        exact hp
  | cons q e ih =>
      simp only [Path.comp_cons, foldSymmPathAvoid, ih, and_assoc]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmPathAvoid_reverse (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (hp : foldSymmPathAvoid e₀ p) :
    foldSymmPathAvoid e₀ p.reverse := by
  induction p with
  | nil => trivial
  | cons p e ih =>
      rw [Path.reverse, foldSymmPathAvoid_comp]
      have hp' : foldSymmPathAvoid e₀ p ∧ symmAllArrow e ≠ e₀ ∧
          symmAllArrow e ≠ allArrowReverse e₀ := by
        simpa [foldSymmPathAvoid] using hp
      refine ⟨?_, ih hp'.1⟩
      simpa only [Quiver.Hom.toPath, foldSymmPathAvoid,
        symmAllArrow_reverse] using
        (show True ∧ symmAllArrow e ≠ e₀ ∧
            symmAllArrow e ≠ allArrowReverse e₀ from
          ⟨True.intro, hp'.2.1, hp'.2.2⟩)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmOrdinaryArrowPath_read {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (he₀ : symmAllArrow e ≠ e₀)
    (her : symmAllArrow e ≠ allArrowReverse e₀) :
    (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀) _ _
      (foldSymmOrdinaryArrowPath e₀ e he₀ her)) =
      separatedMap (L.symmLabel e) := by
  cases e with
  | inl f =>
      simp only [foldSymmOrdinaryArrowPath, BinaryLabelling.pathRead_toPath]
      change separatedMap (L.label f) =
        separatedMap (L.label f)
      rfl
  | inr f =>
      simp only [foldSymmOrdinaryArrowPath, BinaryLabelling.pathRead_reverse,
        BinaryLabelling.pathRead_toPath]
      change (separatedMap (L.label f))⁻¹ =
        separatedMap (factorWordInv (L.label f))
      rw [← separatedMap_factorWordInv]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmOrdinaryPath_read {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (hp : foldSymmPathAvoid e₀ p) :
    (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀) _ _
      (foldSymmOrdinaryPath e₀ p hp)) =
      L.symmPathRead p := by
  induction p with
  | nil =>
      simp only [foldSymmOrdinaryPath.eq_def,
        BinaryLabelling.pathRead_nil, BinaryLabelling.symmPathRead_nil]
  | cons p e ih =>
      have hp' : foldSymmPathAvoid e₀ p ∧ symmAllArrow e ≠ e₀ ∧
          symmAllArrow e ≠ allArrowReverse e₀ := by
        simpa [foldSymmPathAvoid] using hp
      calc
        (@BinaryLabelling.pathRead G H (foldVertex a b)
          _ _ (foldQuiver e₀) (foldHasReverse e₀)
          (foldLabelling L e₀) _ _
          (foldSymmOrdinaryPath e₀ (p.cons e) hp)) =
            (@BinaryLabelling.pathRead G H (foldVertex a b)
              _ _ (foldQuiver e₀) (foldHasReverse e₀)
              (foldLabelling L e₀) _ _
              (foldSymmOrdinaryPath e₀ p hp'.1)) *
              (@BinaryLabelling.pathRead G H (foldVertex a b)
                _ _ (foldQuiver e₀) (foldHasReverse e₀)
                (foldLabelling L e₀) _ _
                (foldSymmOrdinaryArrowPath e₀ e hp'.2.1 hp'.2.2)) := by
          rw [foldSymmOrdinaryPath]
          exact @BinaryLabelling.pathRead_comp G H (foldVertex a b)
            _ _ (foldQuiver e₀) (foldHasReverse e₀) (foldLabelling L e₀)
            _ _ (foldSymmOrdinaryPath e₀ p hp'.1) _
              (foldSymmOrdinaryArrowPath e₀ e hp'.2.1 hp'.2.2)
        _ = L.symmPathRead p * L.symmPathRead e.toPath := by
          rw [ih hp'.1,
            foldSymmOrdinaryArrowPath_read L e₀ e hp'.2.1 hp'.2.2,
            L.symmPathRead_toPath]
        _ = L.symmPathRead (p.cons e) := by
          rw [← Path.comp_toPath_eq_cons, L.symmPathRead_comp,
            L.symmPathRead_toPath]

/-! ### Substitution for an arbitrary symmetrized complementary path -/

/-- Maps a symmetrized edge through a fold using a symmetrized replacement path. -/
def foldSymmEdgePath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
  (hq : foldSymmPathAvoid e₀ q) :
    @Quiver.Path (foldVertex a b) (foldQuiver e₀)
      (foldVertexMk (a := a) (b := b) x)
      (foldVertexMk (a := a) (b := b) y) := by
  classical
  cases e with
  | inl f =>
      by_cases h : allArrowOf f = e₀
      · have hs : (show V from x) = allArrowSource e₀ := by
          exact congrArg allArrowSource h
        have ht : (show V from y) = allArrowTarget e₀ := by
          exact congrArg allArrowTarget h
        have hident :
            foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
              foldVertexMk (a := a) (b := b) b := by
          calc
            foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                foldVertexMk (a := a) (b := b) a := congrArg _ ha
            _ = foldVertexMk (a := a) (b := b) b := by
              exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
        exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
          (foldVertexMk (a := a) (b := b) b)
          (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
          (foldVertexMk (a := a) (b := b) x)
          (foldVertexMk (a := a) (b := b) y)
          (hident.symm.trans
            (congrArg (foldVertexMk (a := a) (b := b)) hs.symm))
          (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)
          (foldSymmOrdinaryPath (a := a) (b := b) e₀ q.reverse
            (foldSymmPathAvoid_reverse e₀ q hq))
      · by_cases h' : allArrowOf f = allArrowReverse e₀
        · have hs : (show V from x) = allArrowTarget e₀ := by
            exact congrArg allArrowSource h'
          have ht : (show V from y) = allArrowSource e₀ := by
            exact congrArg allArrowTarget h'
          exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
            (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
            (foldVertexMk (a := a) (b := b) b)
            (foldVertexMk (a := a) (b := b) x)
            (foldVertexMk (a := a) (b := b) y)
            (congrArg (foldVertexMk (a := a) (b := b)) hs.symm)
            ((by
              have hident :
                  foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                    foldVertexMk (a := a) (b := b) b := by
                calc
                  foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                      foldVertexMk (a := a) (b := b) a := congrArg _ ha
                  _ = foldVertexMk (a := a) (b := b) b := by
                    exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
              exact hident.symm.trans
                (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)))
            (foldSymmOrdinaryPath (a := a) (b := b) e₀ q hq)
        · exact foldSymmOrdinaryArrowPath e₀ (Sum.inl f) h h'
  | inr f =>
      by_cases h : allArrowOf f = e₀
      · have hs : (show V from x) = allArrowTarget e₀ := by
          exact congrArg allArrowTarget h
        have ht : (show V from y) = allArrowSource e₀ := by
          exact congrArg allArrowSource h
        exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
          (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
          (foldVertexMk (a := a) (b := b) b)
          (foldVertexMk (a := a) (b := b) x)
          (foldVertexMk (a := a) (b := b) y)
          (congrArg (foldVertexMk (a := a) (b := b)) hs.symm)
          ((by
            have hident :
                foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                  foldVertexMk (a := a) (b := b) b := by
              calc
                foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                    foldVertexMk (a := a) (b := b) a := congrArg _ ha
                _ = foldVertexMk (a := a) (b := b) b := by
                  exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
            exact hident.symm.trans
              (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)))
          (foldSymmOrdinaryPath (a := a) (b := b) e₀ q hq)
      · by_cases h' : allArrowOf f = allArrowReverse e₀
        · have hs : (show V from x) = allArrowSource e₀ := by
            exact congrArg allArrowTarget h'
          have ht : (show V from y) = allArrowTarget e₀ := by
            exact congrArg allArrowSource h'
          have hident :
              foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                foldVertexMk (a := a) (b := b) b := by
            calc
              foldVertexMk (a := a) (b := b) (allArrowSource e₀) =
                  foldVertexMk (a := a) (b := b) a := congrArg _ ha
              _ = foldVertexMk (a := a) (b := b) b := by
                exact Quotient.sound (Relation.EqvGen.rel a b ⟨rfl, rfl⟩)
          exact @Quiver.Path.cast (foldVertex a b) (foldQuiver e₀)
            (foldVertexMk (a := a) (b := b) b)
            (foldVertexMk (a := a) (b := b) (allArrowTarget e₀))
            (foldVertexMk (a := a) (b := b) x)
            (foldVertexMk (a := a) (b := b) y)
            (hident.symm.trans
              (congrArg (foldVertexMk (a := a) (b := b)) hs.symm))
            (congrArg (foldVertexMk (a := a) (b := b)) ht.symm)
            (foldSymmOrdinaryPath (a := a) (b := b) e₀ q.reverse
              (foldSymmPathAvoid_reverse e₀ q hq))
        · exact foldSymmOrdinaryArrowPath e₀ (Sum.inr f) h h'

/-- Maps symmetrized paths through a fold with the chosen symmetrized detour. -/
def foldSymmMapPath {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q) :
    ∀ {x y : Symmetrify V},
      @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y →
      @Quiver.Path (foldVertex a b) (foldQuiver e₀)
        (foldVertexMk (a := a) (b := b) x)
        (foldVertexMk (a := a) (b := b) y)
  | _, _, Path.nil =>
      @Quiver.Path.nil (foldVertex a b) (foldQuiver e₀) _
  | _, _, Path.cons p e =>
      @Quiver.Path.comp (foldVertex a b) (foldQuiver e₀) _ _ _
        (foldSymmMapPath e₀ ha q hq p)
        (foldSymmEdgePath e₀ ha e q hq)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmEdgePath_read {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    {x y : Symmetrify V}
    (e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q)
    (hread : L.symmPathRead q =
      (separatedMap (allArrowLabel L e₀))⁻¹) :
    (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀) _ _
      (foldSymmEdgePath e₀ ha e q hq)) =
      separatedMap (L.symmLabel e) := by
  classical
  cases e with
  | inl f =>
      by_cases h : allArrowOf f = e₀
      · simp only [foldSymmEdgePath, dite_eq_left h,
          BinaryLabelling.pathRead_cast]
        have hordinary := foldSymmOrdinaryPath_read (a := a) (b := b)
          L e₀ q.reverse (foldSymmPathAvoid_reverse e₀ q hq)
        have hlabel : L.label f = allArrowLabel L e₀ := by
          calc
            L.label f = allArrowLabel L (allArrowOf f) := by rfl
            _ = allArrowLabel L e₀ := congrArg (allArrowLabel L) h
        calc
          _ = L.symmPathRead q.reverse := hordinary
          _ = separatedMap (allArrowLabel L e₀) := by
            rw [L.symmPathRead_reverse, hread, inv_inv]
          _ = separatedMap (L.label f) := by rw [hlabel]
          _ = separatedMap (L.symmLabel (Sum.inl f)) := by rfl
      · by_cases h' : allArrowOf f = allArrowReverse e₀
        · simp only [foldSymmEdgePath, dite_eq_right h, dite_eq_left h',
            BinaryLabelling.pathRead_cast]
          have hordinary := foldSymmOrdinaryPath_read (a := a) (b := b)
            L e₀ q hq
          have hlabel : L.label f =
              factorWordInv (allArrowLabel L e₀) := by
            calc
              L.label f = allArrowLabel L (allArrowOf f) := by rfl
              _ = allArrowLabel L (allArrowReverse e₀) :=
                congrArg (allArrowLabel L) h'
              _ = factorWordInv (allArrowLabel L e₀) := by
                change L.label (Quiver.reverse (allArrowHom e₀)) =
                  factorWordInv (L.label (allArrowHom e₀))
                exact L.reverse_label (allArrowHom e₀)
          calc
            _ = L.symmPathRead q := hordinary
            _ = (separatedMap (allArrowLabel L e₀))⁻¹ := hread
            _ = separatedMap (factorWordInv (allArrowLabel L e₀)) := by
              rw [separatedMap_factorWordInv]
            _ = separatedMap (L.label f) := by rw [hlabel]
            _ = separatedMap (L.symmLabel (Sum.inl f)) := by rfl
        · simpa only [foldSymmEdgePath, dite_eq_right h, dite_eq_right h'] using
            (foldSymmOrdinaryArrowPath_read L e₀ (Sum.inl f) h h')
  | inr f =>
      by_cases h : allArrowOf f = e₀
      · simp only [foldSymmEdgePath, dite_eq_left h,
          BinaryLabelling.pathRead_cast]
        have hordinary := foldSymmOrdinaryPath_read (a := a) (b := b)
          L e₀ q hq
        have hlabel : L.label f = allArrowLabel L e₀ := by
          calc
            L.label f = allArrowLabel L (allArrowOf f) := by rfl
            _ = allArrowLabel L e₀ := congrArg (allArrowLabel L) h
        calc
          _ = L.symmPathRead q := hordinary
          _ = (separatedMap (allArrowLabel L e₀))⁻¹ := hread
          _ = separatedMap (factorWordInv (allArrowLabel L e₀)) := by
            rw [separatedMap_factorWordInv]
          _ = separatedMap (factorWordInv (L.label f)) := by rw [hlabel]
          _ = separatedMap (L.symmLabel (Sum.inr f)) := by rfl
      · by_cases h' : allArrowOf f = allArrowReverse e₀
        · simp only [foldSymmEdgePath, dite_eq_right h, dite_eq_left h',
            BinaryLabelling.pathRead_cast]
          have hordinary := foldSymmOrdinaryPath_read (a := a) (b := b)
            L e₀ q.reverse (foldSymmPathAvoid_reverse e₀ q hq)
          have hlabel : L.label f =
              factorWordInv (allArrowLabel L e₀) := by
            calc
              L.label f = allArrowLabel L (allArrowOf f) := by rfl
              _ = allArrowLabel L (allArrowReverse e₀) :=
                congrArg (allArrowLabel L) h'
              _ = factorWordInv (allArrowLabel L e₀) := by
                change L.label (Quiver.reverse (allArrowHom e₀)) =
                  factorWordInv (L.label (allArrowHom e₀))
                exact L.reverse_label (allArrowHom e₀)
          calc
            _ = L.symmPathRead q.reverse := hordinary
            _ = separatedMap (allArrowLabel L e₀) := by
              rw [L.symmPathRead_reverse, hread, inv_inv]
            _ = separatedMap (factorWordInv (L.label f)) := by
              rw [hlabel]
              simp
            _ = separatedMap (L.symmLabel (Sum.inr f)) := by rfl
        · simpa only [foldSymmEdgePath, dite_eq_right h, dite_eq_right h'] using
            (foldSymmOrdinaryArrowPath_read L e₀ (Sum.inr f) h h')

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmMapPath_read {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q)
    (hread : L.symmPathRead q =
      (separatedMap (allArrowLabel L e₀))⁻¹) :
    ∀ {x y : Symmetrify V}
      (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y),
      (@BinaryLabelling.pathRead G H (foldVertex a b)
        _ _ (foldQuiver e₀) (foldHasReverse e₀)
        (foldLabelling L e₀) _ _
        (foldSymmMapPath e₀ ha q hq p)) = L.symmPathRead p := by
  intro x y p
  induction p with
  | nil =>
      simp only [foldSymmMapPath, BinaryLabelling.pathRead_nil,
        BinaryLabelling.symmPathRead_nil]
  | cons p e ih =>
      calc
        (@BinaryLabelling.pathRead G H (foldVertex a b)
          _ _ (foldQuiver e₀) (foldHasReverse e₀)
          (foldLabelling L e₀) _ _
          (foldSymmMapPath e₀ ha q hq (p.cons e))) =
            (@BinaryLabelling.pathRead G H (foldVertex a b)
              _ _ (foldQuiver e₀) (foldHasReverse e₀)
              (foldLabelling L e₀) _ _
              (foldSymmMapPath e₀ ha q hq p)) *
              (@BinaryLabelling.pathRead G H (foldVertex a b)
                _ _ (foldQuiver e₀) (foldHasReverse e₀)
                (foldLabelling L e₀) _ _
                (foldSymmEdgePath e₀ ha e q hq)) := by
          rw [foldSymmMapPath]
          exact @BinaryLabelling.pathRead_comp G H (foldVertex a b)
            _ _ (foldQuiver e₀) (foldHasReverse e₀) (foldLabelling L e₀)
            _ _ (foldSymmMapPath e₀ ha q hq p) _
              (foldSymmEdgePath e₀ ha e q hq)
        _ = L.symmPathRead p * L.symmPathRead e.toPath := by
          rw [ih, foldSymmEdgePath_read L e₀ ha e q hq hread,
            L.symmPathRead_toPath]
        _ = L.symmPathRead (p.cons e) := by
          rw [← Path.comp_toPath_eq_cons, L.symmPathRead_comp,
            L.symmPathRead_toPath]

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldEdgePath_read {a b : V} (L : BinaryLabelling (G := G)
    (H := H) (V := V)) (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a) {x y : V} (e : x ⟶ y)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q)
    (hread : L.pathRead q =
      (separatedMap (allArrowLabel L e₀))⁻¹) :
    (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling L e₀)
      _ _
      (foldEdgePath e₀ ha e q hq)) = L.pathRead e.toPath := by
  classical
  by_cases h : allArrowOf e = e₀
  · simp only [foldEdgePath, dite_eq_left h, BinaryLabelling.pathRead_cast]
    rw [foldOrdinaryPath_read L e₀ q.reverse (foldPathAvoid_reverse e₀ q hq)]
    rw [BinaryLabelling.pathRead_reverse L q, hread, inv_inv]
    rw [L.pathRead_toPath]
    have hlabel : L.label e = allArrowLabel L e₀ := by
      calc
        L.label e = allArrowLabel L (allArrowOf e) := by rfl
        _ = allArrowLabel L e₀ := congrArg (allArrowLabel L) h
    exact congrArg separatedMap hlabel.symm
  · by_cases h' : allArrowOf e = allArrowReverse e₀
    · simp only [foldEdgePath, dite_eq_right h, dite_eq_left h',
        BinaryLabelling.pathRead_cast]
      rw [foldOrdinaryPath_read L e₀ q hq, hread]
      rw [L.pathRead_toPath]
      have hlabel : L.label e = factorWordInv (allArrowLabel L e₀) := by
        calc
          L.label e = allArrowLabel L (allArrowOf e) := by rfl
          _ = allArrowLabel L (allArrowReverse e₀) := congrArg (allArrowLabel L) h'
          _ = factorWordInv (allArrowLabel L e₀) := by
            change L.label (Quiver.reverse (allArrowHom e₀)) =
              factorWordInv (L.label (allArrowHom e₀))
            exact L.reverse_label (allArrowHom e₀)
      rw [hlabel, separatedMap_factorWordInv]
    · simp only [foldEdgePath, dite_eq_right h, dite_eq_right h']
      rfl

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldMapPath_read {a b : V} (L : BinaryLabelling (G := G)
    (H := H) (V := V)) (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q)
    (hread : L.pathRead q =
      (separatedMap (allArrowLabel L e₀))⁻¹) :
    ∀ {x y : V} (p : @Quiver.Path V _ x y),
      (@BinaryLabelling.pathRead G H (foldVertex a b)
        _ _ (foldQuiver e₀) (foldHasReverse e₀)
        (foldLabelling L e₀)
        _ _
        (foldMapPath e₀ ha q hq p)) = L.pathRead p := by
  intro x y p
  induction p with
  | nil =>
      simp only [foldMapPath, BinaryLabelling.pathRead_nil]
  | cons p e ih =>
      calc
        (@BinaryLabelling.pathRead G H (foldVertex a b)
          _ _ (foldQuiver e₀) (foldHasReverse e₀)
          (foldLabelling L e₀) _ _
          (foldMapPath e₀ ha q hq (p.cons e))) =
            (@BinaryLabelling.pathRead G H (foldVertex a b)
              _ _ (foldQuiver e₀) (foldHasReverse e₀)
              (foldLabelling L e₀) _ _
              (foldMapPath e₀ ha q hq p)) *
              (@BinaryLabelling.pathRead G H (foldVertex a b)
                _ _ (foldQuiver e₀) (foldHasReverse e₀) (foldLabelling L e₀)
                _ _ (foldEdgePath e₀ ha e q hq)) := by
          rw [foldMapPath]
          exact @BinaryLabelling.pathRead_comp G H (foldVertex a b)
            _ _ (foldQuiver e₀) (foldHasReverse e₀) (foldLabelling L e₀)
            _ _ (foldMapPath e₀ ha q hq p) _
              (foldEdgePath e₀ ha e q hq)
        _ = L.pathRead p * L.pathRead e.toPath := by
          rw [ih, foldEdgePath_read L e₀ ha e q hq hread]
        _ = L.pathRead (p.cons e) := by
          rw [← L.pathRead_comp p e.toPath]
          rfl

/-! ### Marked graphs after one safe fold -/

/-- The marked graph obtained by folding and transporting its marking paths. -/
def foldedMarkedGraph {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q) :
    @MarkedBinaryGraph G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀) n :=
  @MarkedBinaryGraph.mk G H (foldVertex a b) _ _
    (foldQuiver e₀) (foldHasReverse e₀) n
    (foldVertexMk (a := a) (b := b) M.base)
    (foldLabelling M.labeling e₀)
    (fun i => foldMapPath e₀ ha q hq (M.loops i))

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraph_read {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q)
    (hread : M.labeling.pathRead q =
      (separatedMap (allArrowLabel M.labeling e₀))⁻¹) :
    (@MarkedBinaryGraph.read n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraph M e₀ ha q hq)) = M.read := by
  funext i
  change (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling M.labeling e₀) _ _
      (foldMapPath e₀ ha q hq (M.loops i))) =
    M.labeling.pathRead (M.loops i)
  exact foldMapPath_read M.labeling e₀ ha q hq hread (M.loops i)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraph_isGenerating {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q)
    (hread : M.labeling.pathRead q =
      (separatedMap (allArrowLabel M.labeling e₀))⁻¹)
    (hM : M.IsGenerating) :
    (@MarkedBinaryGraph.IsGenerating n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraph M e₀ ha q hq)) := by
  change Subgroup.closure (Set.range (@MarkedBinaryGraph.read n G H
    (foldVertex a b) _ _ (foldQuiver e₀) (foldHasReverse e₀)
    (foldedMarkedGraph M e₀ ha q hq))) = ⊤
  rw [foldedMarkedGraph_read M e₀ ha q hq hread]
  exact hM

/-! The corresponding constructor for an arbitrary symmetrized complementary
path.  The marked loops are first viewed in the symmetrized quiver, then
mapped edge-by-edge through the fold. -/

/-- The marked graph obtained by folding with a symmetrized replacement path. -/
def foldedMarkedGraphSymm {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q) :
    @MarkedBinaryGraph G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀) n :=
  @MarkedBinaryGraph.mk G H (foldVertex a b) _ _
    (foldQuiver e₀) (foldHasReverse e₀) n
    (foldVertexMk (a := a) (b := b) M.base)
    (foldLabelling M.labeling e₀)
    (fun i => foldSymmMapPath e₀ ha q hq
      ((@Quiver.Symmetrify.of V qV).mapPath (M.loops i)))

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraphSymm_read {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q)
    (hread : M.labeling.symmPathRead q =
      (separatedMap (allArrowLabel M.labeling e₀))⁻¹) :
    (@MarkedBinaryGraph.read n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraphSymm M e₀ ha q hq)) = M.read := by
  funext i
  change (@BinaryLabelling.pathRead G H (foldVertex a b)
      _ _ (foldQuiver e₀) (foldHasReverse e₀)
      (foldLabelling M.labeling e₀) _ _
      (foldSymmMapPath e₀ ha q hq
        ((@Quiver.Symmetrify.of V qV).mapPath (M.loops i)))) =
    M.labeling.pathRead (M.loops i)
  calc
    _ = M.labeling.symmPathRead
        ((@Quiver.Symmetrify.of V qV).mapPath (M.loops i)) :=
      foldSymmMapPath_read M.labeling e₀ ha q hq hread
        ((@Quiver.Symmetrify.of V qV).mapPath (M.loops i))
    _ = M.labeling.pathRead (M.loops i) :=
      M.labeling.symmPathRead_map_of (M.loops i)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraphSymm_isGenerating {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q)
    (hread : M.labeling.symmPathRead q =
      (separatedMap (allArrowLabel M.labeling e₀))⁻¹)
    (hM : M.IsGenerating) :
    (@MarkedBinaryGraph.IsGenerating n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraphSymm M e₀ ha q hq)) := by
  change Subgroup.closure (Set.range (@MarkedBinaryGraph.read n G H
    (foldVertex a b) _ _ (foldQuiver e₀) (foldHasReverse e₀)
    (foldedMarkedGraphSymm M e₀ ha q hq))) = ⊤
  rw [foldedMarkedGraphSymm_read M e₀ ha q hq hread]
  exact hM

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraphSymm_weaklyConnected {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
      ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
      ((@Quiver.Symmetrify.of V qV).obj b))
    (hq : foldSymmPathAvoid e₀ q)
    (hM : M.WeaklyConnected) :
    @MarkedBinaryGraph.WeaklyConnected n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraphSymm M e₀ ha q hq) := by
  intro v
  refine Quotient.inductionOn v ?_
  intro v
  obtain ⟨p⟩ := hM v
  let r := foldSymmMapPath e₀ ha q hq p
  exact ⟨@Prefunctor.mapPath (foldVertex a b) (foldQuiver e₀)
    (Symmetrify (foldVertex a b))
    (@Quiver.symmetrifyQuiver (foldVertex a b) (foldQuiver e₀))
    (@Quiver.Symmetrify.of (foldVertex a b) (foldQuiver e₀)) _ _ r⟩

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldedMarkedGraph_weaklyConnected {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (e₀ : AllArrow (V := V))
    (ha : allArrowSource e₀ = a)
    (q : @Quiver.Path V _ (allArrowTarget e₀) b)
    (hq : foldPathAvoid e₀ q)
    (hM : M.WeaklyConnected) :
    @MarkedBinaryGraph.WeaklyConnected n G H (foldVertex a b) _ _
      (foldQuiver e₀) (foldHasReverse e₀)
      (foldedMarkedGraph M e₀ ha q hq) := by
  intro v
  refine Quotient.inductionOn v ?_
  intro v
  obtain ⟨p⟩ := hM v
  exact ⟨foldSymmPath e₀ ha q hq p⟩

omit [(a b : V) → Fintype (a ⟶ b)] in
omit [hV : Quiver.HasInvolutiveReverse V] in
omit [qV : Quiver V] in
theorem foldedMarkedGraph_card_lt {a b : V} (hab : a ≠ b) :
    Fintype.card (foldVertex a b) < Fintype.card V :=
  foldQuotient_card_lt hab

/-! ### The exact obstruction to a safe fold -/

/-- An occurrence of one of the two orientations of a geometric edge in a
complementary path.  The explicit prefix and suffix are retained so that an
unfold can later be performed at the occurrence, rather than merely knowing
that the recursive avoidance predicate failed. -/
def SymmEdgeOccurrence (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) : Prop :=
  ∃ u z : Symmetrify V,
    ∃ r : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x u,
    ∃ e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) u z,
    ∃ s : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) z y,
      p = r.comp (e.toPath.comp s) ∧
        (symmAllArrow e = e₀ ∨
          symmAllArrow e = allArrowReverse e₀)

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem foldSymmPathAvoid_or_occurrence (e₀ : AllArrow (V := V))
    {x y : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) x y) :
    foldSymmPathAvoid e₀ p ∨ SymmEdgeOccurrence (qV := qV) e₀ p := by
  induction p with
  | nil =>
      exact Or.inl (by simp [foldSymmPathAvoid])
  | cons p e ih =>
      rcases ih with hp | hocc
      · by_cases he₀ : symmAllArrow e = e₀
        · exact Or.inr ⟨_, _, p, e, Path.nil, by
            rw [← Path.comp_toPath_eq_cons]
            simp, Or.inl he₀⟩
        · by_cases her : symmAllArrow e = allArrowReverse e₀
          · exact Or.inr ⟨_, _, p, e, Path.nil, by
              rw [← Path.comp_toPath_eq_cons]
              simp, Or.inr her⟩
          · exact Or.inl (by
              simpa [foldSymmPathAvoid] using ⟨hp, he₀, her⟩)
      · rcases hocc with ⟨u, z, r, f, s, hps, hf⟩
        exact Or.inr ⟨u, z, r, f, s.comp e.toPath, by
          rw [← Path.comp_toPath_eq_cons, hps]
          simp only [Path.comp_assoc], hf⟩

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem exists_safe_or_reused_fold_data
    {a b : Symmetrify V}
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b)
    (hp : p.length ≠ 0) :
    ∃ c : Symmetrify V,
      ∃ e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b,
          p = e.toPath.comp q ∧
          (foldSymmPathAvoid (symmOrientedArrow e) q ∨
              SymmEdgeOccurrence (qV := qV) (symmOrientedArrow e) q) := by
  obtain ⟨c, e, q, hpq⟩ :=
    BinaryLabelling.exists_first_edge_comp (V := V) p hp
  rcases foldSymmPathAvoid_or_occurrence (qV := qV)
      (symmOrientedArrow e) q with hq | hq
  · exact ⟨c, e, q, hpq, Or.inl hq⟩
  · exact ⟨c, e, q, hpq, Or.inr hq⟩

/-! ### Extracting a safe fold from a null path -/

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem safeFoldData_of_nullPath {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (p : @Quiver.Path V _ a b) (hp : L.pathRead p = 1)
    (hdecomp : ∃ (c : V) (e : a ⟶ c) (q : @Quiver.Path V _ c b),
      p = e.toPath.comp q ∧ foldPathAvoid (allArrowOf e) q) :
    ∃ (c : V) (e : a ⟶ c) (q : @Quiver.Path V _ c b),
      p = e.toPath.comp q ∧ foldPathAvoid (allArrowOf e) q ∧
        L.pathRead q =
          (separatedMap (allArrowLabel L (allArrowOf e)))⁻¹ := by
  obtain ⟨c, e, q, hpq, hq⟩ := hdecomp
  refine ⟨c, e, q, hpq, hq, ?_⟩
  have hprod : L.pathRead e.toPath * L.pathRead q = 1 := by
    calc
      L.pathRead e.toPath * L.pathRead q =
          L.pathRead (e.toPath.comp q) :=
        (L.pathRead_comp e.toPath q).symm
      _ = L.pathRead p := by rw [hpq]
      _ = 1 := hp
  have hq' : L.pathRead q = (L.pathRead e.toPath)⁻¹ :=
    eq_inv_of_mul_eq_one_right hprod
  simpa [allArrowLabel] using hq'

/-! ### The corresponding safe-data extraction for symmetrized paths -/

omit [Fintype V] [(a b : V) → Fintype (a ⟶ b)] in
theorem safeSymmFoldData_of_nullPath
    {a b : V}
    (L : BinaryLabelling (G := G) (H := H) (V := V))
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b)
    (hp : L.symmPathRead p = 1)
    (hdecomp : ∃ c : Symmetrify V,
      ∃ e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b,
          p = e.toPath.comp q ∧
            foldSymmPathAvoid (symmOrientedArrow e) q) :
    ∃ c : Symmetrify V,
      ∃ e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b,
          p = e.toPath.comp q ∧
            foldSymmPathAvoid (symmOrientedArrow e) q ∧
            L.symmPathRead q =
              (separatedMap
                (allArrowLabel L (symmOrientedArrow e)))⁻¹ := by
  obtain ⟨c, e, q, hpq, hqavoid⟩ := hdecomp
  refine ⟨c, e, q, hpq, hqavoid, ?_⟩
  have hprod : L.symmPathRead e.toPath * L.symmPathRead q = 1 := by
    calc
      L.symmPathRead e.toPath * L.symmPathRead q =
          L.symmPathRead (e.toPath.comp q) :=
        (L.symmPathRead_comp e.toPath q).symm
      _ = L.symmPathRead p := by rw [hpq]
      _ = 1 := hp
  have hq' : L.symmPathRead q =
      (L.symmPathRead e.toPath)⁻¹ :=
    eq_inv_of_mul_eq_one_right hprod
  exact hq'.trans (congrArg Inv.inv ((L.symmPathRead_toPath e).trans
    (congrArg separatedMap (symmLabel_eq_allArrowLabel_oriented L e))))

omit [(a b : V) → Fintype (a ⟶ b)] in
theorem exists_safe_folded_marked_graph {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (hab : a ≠ b)
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b)
    (hp : M.labeling.symmPathRead p = 1)
    (hdecomp : ∃ c : Symmetrify V,
      ∃ e : @Quiver.Hom (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a c,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) c b,
          p = e.toPath.comp q ∧
            foldSymmPathAvoid (symmOrientedArrow e) q)
    (hgen : M.IsGenerating) (hconn : M.WeaklyConnected) :
    ∃ e₀ : AllArrow (V := V),
      ∃ ha : allArrowSource e₀ = a,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
          ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
          ((@Quiver.Symmetrify.of V qV).obj b),
          ∃ hq : foldSymmPathAvoid e₀ q,
            @MarkedBinaryGraph.IsGenerating n G H (foldVertex a b) _ _
                (foldQuiver e₀) (foldHasReverse e₀)
                (foldedMarkedGraphSymm M e₀ ha q hq) ∧
            @MarkedBinaryGraph.WeaklyConnected n G H (foldVertex a b) _ _
                (foldQuiver e₀) (foldHasReverse e₀)
                (foldedMarkedGraphSymm M e₀ ha q hq) ∧
            Fintype.card (foldVertex a b) < Fintype.card V := by
  obtain ⟨c, e, q, hpq, hqavoid, hqread⟩ :=
    safeSymmFoldData_of_nullPath (qV := qV) M.labeling p hp hdecomp
  let e₀ := symmOrientedArrow e
  have ha : allArrowSource e₀ = a := by
    simpa [e₀] using symmOrientedArrow_source e
  have hct : c =
      (@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀) := by
    exact (symmOrientedArrow_target e).symm
  let q' := q.cast hct rfl
  have hqavoid' : foldSymmPathAvoid e₀ q' := by
    rw [show foldSymmPathAvoid e₀ q' ↔ foldSymmPathAvoid e₀ q by
      simpa [q'] using
        foldSymmPathAvoid_cast (e₀ := e₀) hct rfl q]
    exact hqavoid
  have hqread' : M.labeling.symmPathRead q' =
      (separatedMap (allArrowLabel M.labeling e₀))⁻¹ := by
    calc
      M.labeling.symmPathRead q' = M.labeling.symmPathRead q := by
        simpa [q'] using M.labeling.symmPathRead_cast hct rfl q
      _ = (separatedMap (allArrowLabel M.labeling e₀))⁻¹ := hqread
  refine ⟨e₀, ha, q', hqavoid', ?_, ?_, ?_⟩
  · exact foldedMarkedGraphSymm_isGenerating M e₀ ha q' hqavoid' hqread' hgen
  · exact foldedMarkedGraphSymm_weaklyConnected M e₀ ha q' hqavoid' hconn
  · exact foldQuotient_card_lt hab

omit [(a b : V) → Fintype (a ⟶ b)] in
theorem exists_safe_folded_marked_graph_of_geometrically_simple {n : ℕ}
    (M : MarkedBinaryGraph (G := G) (H := H) (V := V) n)
    {a b : V} (hab : a ≠ b)
    (p : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV) a b)
    (hp : M.labeling.symmPathRead p = 1)
    (hsimple : GeometricallySimple (qV := qV) p)
    (hgen : M.IsGenerating) (hconn : M.WeaklyConnected) :
    ∃ e₀ : AllArrow (V := V),
      ∃ ha : allArrowSource e₀ = a,
        ∃ q : @Quiver.Path (Symmetrify V) (@Quiver.symmetrifyQuiver V qV)
          ((@Quiver.Symmetrify.of V qV).obj (allArrowTarget e₀))
          ((@Quiver.Symmetrify.of V qV).obj b),
          ∃ hq : foldSymmPathAvoid e₀ q,
            @MarkedBinaryGraph.IsGenerating n G H (foldVertex a b) _ _
                (foldQuiver e₀) (foldHasReverse e₀)
                (foldedMarkedGraphSymm M e₀ ha q hq) ∧
            @MarkedBinaryGraph.WeaklyConnected n G H (foldVertex a b) _ _
                (foldQuiver e₀) (foldHasReverse e₀)
                (foldedMarkedGraphSymm M e₀ ha q hq) ∧
            Fintype.card (foldVertex a b) < Fintype.card V := by
  have hp_len : p.length ≠ 0 := by
    intro hzero
    apply hab
    exact @Path.eq_of_length_zero (Symmetrify V)
      (@Quiver.symmetrifyQuiver V qV) a b p hzero
  obtain ⟨c, e, q, hpq⟩ :=
    BinaryLabelling.exists_first_edge_comp (V := V) p hp_len
  have hqavoid : foldSymmPathAvoid (symmOrientedArrow e) q := by
    apply foldSymmPathAvoid_of_geometricallySimple e q
    rw [← hpq]
    exact hsimple
  exact exists_safe_folded_marked_graph M hab p hp
    ⟨c, e, q, hpq, hqavoid⟩ hgen hconn

