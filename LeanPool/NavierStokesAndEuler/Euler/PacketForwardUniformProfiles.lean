@[expose] public section

noncomputable section

namespace EulerPacketCylinderField

open Set EulerSmoothLimit EulerPacketPointJets EulerPacketProfileRecursion
  EulerPacketTimeProfile EulerParameterWordGevrey EulerTransversePacketProvider

variable (P : ℝ) [Fact (0 < P)] (M : EulerMeanPacketProvider.Data)
  {U : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  (D : Data U) (hTime : M.T = D.T) (Y : InitialData P D)

/-- Forward source primary witness, given by `(homogeneousPrimaryRegularity D Y (sourceOperators
P M D (InitialData.zero P D)) rfl).changeTime hTime.symm M.T_pos.le`. -/
def forwardSourcePrimaryWitness :
    ProfileRegularity P M.T M.T_pos.le D.support
      (homogeneousPrimary D Y (sourceOperators P M D (InitialData.zero P D))) :=
  (homogeneousPrimaryRegularity D Y (sourceOperators P M D (InitialData.zero P D)) rfl).changeTime
    hTime.symm M.T_pos.le

variable (L : EulerTransversePacketForward.Budget D (Fin 4) 6)
  (N : EulerTransversePacketJoin.NormalBudget D 6 L.R)
  (W : EulerTransversePacketForward.Budget.GradeGuards (P := P) L N 1)
  (LM : EulerMeanPacketProvider.Budget M 6 L.R)
  (WM : EulerMeanPacketProvider.Budget.GradeGuards LM)
  (BC : CoefficientBudget (sourceCoefficientData P M D (InitialData.zero P D) hTime))
  (hRc : sobolevCoefficientRadius (Fin 4) BC.Rc ≤ L.R) (hcost : BC.termCost ≤ L.R)
  (S : Scales (Icc (0 : ℝ) M.T)) (α : ℝ) (hα : 0 < α)
  (hgrowth : timeProfileChange S.growth hTime = α • L.g)
  (hprimaryBudget : ProfileBudget (forwardSourcePrimaryWitness P M D hTime Y) S L.R 1)

include N W LM WM BC hRc hcost hα hgrowth hprimaryBudget

theorem forwardSource_profile_budgets (p : ℕ) : 1 ≤ p →
    ProfileBudget (sourceProfileWitness P M D hTime (InitialData.zero P D) Y p) S L.R p := by
  induction p using Nat.strong_induction_on with
  | h p ih =>
    intro hp
    by_cases hp1 : p = 1
    · subst p
      apply hprimaryBudget.of_profile_eq M.T_pos
      simp only [sourceProfiles,profiles_one]
    have hp2 : 2 ≤ p := by omega
    let I := InitialData.zero P D
    let a := sourceProfiles P M D I Y
    let O := sourceOperators P M D I
    let C := sourceCoefficientData P M D I hTime
    let G : ∀ i, i < p → ProfileRegularity P M.T M.T_pos.le D.support (a i) :=
      fun i _ => sourceProfileWitness P M D hTime I Y i
    have hG : ∀ i (hi : i < p), 1 ≤ i → ProfileBudget (G i hi) S L.R i :=
      fun i hi hi1 => ih i hi hi1
    have he : a p = EulerPacketProfileRecursion.step O p a :=
      profiles_step O (homogeneousPrimary D Y O) p hp2
    let H := (sourceProfileWitness P M D hTime I Y p).congr he
    have hc₀ : (a 0).corrector = 0 := by simp only [a,sourceProfiles,profiles_zero]; rfl
    have hB₁ : (a 1).mean = 0 := by
      simp only [a,sourceProfiles,profiles_one,homogeneousPrimary,primaryProfile]
    have hA : ∀ i, i < p → ∀ (t : Icc (0 : ℝ) M.T) x θ,
        inner ℝ (O.normal (t,(x,θ))) ((a i).high (t,(x,θ))) = 0 :=
      fun i _ t x θ => source_high_tangent P M D hTime I Y i t x θ
    have hStep : ProfileBudget H S L.R p :=
      ProfileBudget.forwardStep M D hTime L N W LM WM C BC rfl rfl rfl hRc hcost S
        hp2 G hG hc₀ hB₁ hA (α*meanScale S.H0 p) (S.gradeFactor_pos α hα p)
        (S.high_timeProfile_eq hTime L.g α hgrowth p) H
    exact hStep.of_profile_eq M.T_pos _ he.symm

end EulerPacketCylinderField
