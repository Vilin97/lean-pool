@[simp]
theorem assocInvFeo_tmulOE (m : M.even) (n : N.odd) (p : P.even) :
    assocInvFeo M N P m (tmulOE N P n p)
      = tmulOE (M.tensor N) P (tmulEO M N m n) p :=
