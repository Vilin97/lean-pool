namespace AVenhance

/-- `(∂_t - κ Δ + b · ∇) u`, classical derivatives (source order of `e.theta.m`, label 3856). -/
def advDiffOp (b : ℝ → Vec 2 → Vec 2) (κ : ℝ) (u : ℝ → Vec 2 → ℝ) (t : ℝ) (x : Vec 2) : ℝ :=
  deriv (fun s => u s x) t - κ * spaceLap (u t) x + vecDot (b t x) (spaceGrad (u t) x)

end AVenhance
