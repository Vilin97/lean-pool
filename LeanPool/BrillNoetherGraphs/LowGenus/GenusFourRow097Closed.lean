/-! ## Finite-index bookkeeping -/

theorem sum_univ_nine {M : Type*} [AddCommMonoid M] (f : Fin 9 → M) :
    ∑ i : Fin 9, f i =
      f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 + f 7 + f 8 := by
  rw [Fin.sum_univ_castSucc (f := f),
    Fin.sum_univ_eight (f := fun i : Fin 8 => f i.castSucc)]
  rfl

theorem forall_fin_nine {P : Fin 9 → Prop} (h0 : P 0) (h1 : P 1) (h2 : P 2)
    (h3 : P 3) (h4 : P 4) (h5 : P 5) (h6 : P 6) (h7 : P 7) (h8 : P 8) :
    ∀ e : Fin 9, P e := by
  intro e
  fin_cases e
  exacts [h0, h1, h2, h3, h4, h5, h6, h7, h8]

theorem forall_fin_six {P : Fin 6 → Prop} (h0 : P 0) (h1 : P 1) (h2 : P 2)
    (h3 : P 3) (h4 : P 4) (h5 : P 5) : ∀ v : Fin 6, P v := by
  intro v
  fin_cases v
  exacts [h0, h1, h2, h3, h4, h5]

/-! ## Rank one from reaching the core classes

The closed-orthant analogue of
`Utilities.Certificate.CoreVertexReachability.bnExists_of_reaches_coreVertices`.
Both hypotheses it needs about the ambient graph are already hypothesis-free on
a `DegSpec`: the class vertices are a strong separator
(`DegSpec.strongSeparatorCertificate`) and connectivity comes from the finite
cut certificate on the *uncontracted* core
(`DegSpec.graph_connected_of_coreConnected`). -/

section Reachability

variable {n p : ℕ}

theorem bnExists_of_reaches_coreVertices (d : DegSpec n p)
    (hCore : d.core.Connected) (D : CFDiv d.graph) (degree : ℤ)
    (hDegree : deg D = degree)
    (hReaches : ∀ v : Fin n, StrongSeparator.Reaches d.graph D (d.coreVertex v)) :
    BNExists d.graph 1 degree := by
  refine ⟨D, hDegree, ?_⟩
  apply StrongSeparator.rank_ge_one_of_strongSeparatorCertificate
    (d.graph_connected_of_coreConnected hCore)
    (ExplicitPotential.CertificateData.degenerateCoreVertices_nonempty d)
    d.strongSeparatorCertificate
  intro vertex hVertex
  obtain ⟨anchor, -, rfl⟩ := Finset.mem_image.mp hVertex
  exact hReaches anchor

end Reachability

/-! ## The oriented row-097 core -/

/-- The orientation data of the row-097 split core, read on the **core** rather
than on a positive subdivision: on the closed orthant the slot lengths are not
part of this datum. -/
structure IsCore097 (core : ExplicitPotential.Core 6 9) : Prop where
  t0 : core.tail 0 = 0
  t1 : core.tail 1 = 0
  t2 : core.tail 2 = 0
  t3 : core.tail 3 = 1
  t4 : core.tail 4 = 1
  t5 : core.tail 5 = 1
  t6 : core.tail 6 = 2
  t7 : core.tail 7 = 2
  t8 : core.tail 8 = 3
  h0 : core.head 0 = 4
  h1 : core.head 1 = 5
  h2 : core.head 2 = 5
  h3 : core.head 3 = 2
  h4 : core.head 4 = 3
  h5 : core.head 5 = 5
  h6 : core.head 6 = 3
  h7 : core.head 7 = 4
  h8 : core.head 8 = 4

namespace IsCore097

variable {core : ExplicitPotential.Core 6 9}

/-- The row-097 core is connected: any nonempty proper cut of the six vertices
is crossed by some slot.  Assuming no slot crosses the cut, the nine slots link
all six vertices into a single chain `0 - 4`, `0 - 5 - 1`, `1 - 2`, `1 - 3`, so
every vertex agrees with `0`. -/
theorem core_connected (hp : IsCore097 core) : core.Connected := by
  intro S hS
  obtain ⟨v, w, hv, hw⟩ := hS
  by_contra hNoCross
  simp only [not_exists, not_or] at hNoCross
  have hIffEdge : ∀ edge : Fin 9, core.tail edge ∈ S ↔ core.head edge ∈ S := by
    intro edge
    have he := hNoCross edge
    constructor
    · intro hA
      by_contra hB
      exact he.1 ⟨hA, hB⟩
    · intro hB
      by_contra hA
      exact he.2 ⟨hB, hA⟩
  have h04 : (0 : Fin 6) ∈ S ↔ (4 : Fin 6) ∈ S := by
    have := hIffEdge 0; rwa [hp.t0, hp.h0] at this
  have h05 : (0 : Fin 6) ∈ S ↔ (5 : Fin 6) ∈ S := by
    have := hIffEdge 1; rwa [hp.t1, hp.h1] at this
  have h15 : (1 : Fin 6) ∈ S ↔ (5 : Fin 6) ∈ S := by
    have := hIffEdge 5; rwa [hp.t5, hp.h5] at this
  have h12 : (1 : Fin 6) ∈ S ↔ (2 : Fin 6) ∈ S := by
    have := hIffEdge 3; rwa [hp.t3, hp.h3] at this
  have h13 : (1 : Fin 6) ∈ S ↔ (3 : Fin 6) ∈ S := by
    have := hIffEdge 4; rwa [hp.t4, hp.h4] at this
  have h01 : (0 : Fin 6) ∈ S ↔ (1 : Fin 6) ∈ S := h05.trans h15.symm
  have h02 : (0 : Fin 6) ∈ S ↔ (2 : Fin 6) ∈ S := h01.trans h12
  have h03 : (0 : Fin 6) ∈ S ↔ (3 : Fin 6) ∈ S := h01.trans h13
  have hAll : ∀ u : Fin 6, u ∈ S ↔ (0 : Fin 6) ∈ S := by
    refine forall_fin_six ?_ ?_ ?_ ?_ ?_ ?_
    · exact Iff.rfl
    · exact h01.symm
    · exact h02.symm
    · exact h03.symm
    · exact h04.symm
    · exact h05.symm
  exact hw (((hAll v).trans (hAll w).symm).mp hv)

end IsCore097

/-! ## The pencil parameters

Every parameter is a function of the length vector alone; no positivity and no
spec is involved. -/

section Parameters

variable (L : Fin 9 → ℕ)

/-- Depth of the moving chip on slot `e3`. -/
def dpos : ℕ := min (L 0 - L 5) (L 4)

/-- Residual handle imbalance. -/
def cRest : ℕ := L 0 - L 5 - dpos L

/-- Length of the `star 2` march. -/
def uMax : ℕ := min (L 3 - dpos L) (min (L 6) (L 7))

/-- Length of the second pass of the `{e0,e5}` march. -/
def m2Max : ℕ := min (cRest L) (L 5)

/-- Length of the `star 0` march. -/
def wMax : ℕ := min (cRest L - m2Max L) (min (L 1) (L 2))

end Parameters

/-! ## The four marches -/

section Marches

variable (L : Fin 9 → ℕ)

/-- Core potential of the `star 2` march. -/
def vPot (u : ℕ) : Fin 6 → ℤ := fun v => if v = 2 then -(u : ℤ) else 0

/-- Slot signs of the `star 2` march. -/
def vSgn : Fin 9 → ℤ := fun e =>
  if e = 3 then -1 else if e = 6 then 1 else if e = 7 then 1 else 0

/-- Window starts of the `star 2` march. -/
def vLo (u : ℕ) : Fin 9 → ℕ := fun e =>
  if e = 3 then dpos L
  else if e = 6 then L 6 - u
  else if e = 7 then L 7 - u else 0

/-- Core potential of the `{e0,e3,e4}` march. -/
def pPot (s : ℕ) : Fin 6 → ℤ := fun v =>
  if v = 0 then -(s : ℤ) else if v = 1 then -(s : ℤ)
  else if v = 5 then -(s : ℤ) else 0

/-- Slot signs of the `{e0,e3,e4}` march. -/
def pSgn : Fin 9 → ℤ := fun e =>
  if e = 0 then 1 else if e = 3 then 1 else if e = 4 then 1 else 0

/-- Window starts of the `{e0,e3,e4}` march. -/
def pLo (s : ℕ) : Fin 9 → ℕ := fun e =>
  if e = 0 then L 0 - s
  else if e = 3 then dpos L - s
  else if e = 4 then L 4 - s else 0

/-- Core potential of the `{e0,e5}` march. -/
def mPot (r : ℕ) : Fin 6 → ℤ := fun v =>
  if v = 0 then -(r : ℤ) else if v = 5 then -(r : ℤ) else 0

/-- Slot signs of the `{e0,e5}` march. -/
def mSgn : Fin 9 → ℤ := fun e =>
  if e = 0 then 1 else if e = 5 then -1 else 0

/-- Window starts of the `{e0,e5}` march starting from depth `a` on `e0`. -/
def mLo (a r : ℕ) : Fin 9 → ℕ := fun e => if e = 0 then a - r else 0

/-- Core potential of the `star 0` march. -/
def wPot (w : ℕ) : Fin 6 → ℤ := fun v => if v = 0 then -(w : ℤ) else 0

/-- Slot signs of the `star 0` march. -/
def wSgn : Fin 9 → ℤ := fun e =>
  if e = 0 then 1 else if e = 1 then 1 else if e = 2 then 1 else 0

/-- Window starts of the `star 0` march. -/
def wLo (w : ℕ) : Fin 9 → ℕ := fun e =>
  if e = 0 then cRest L - m2Max L - w
  else if e = 1 then L 1 - w
  else if e = 2 then L 2 - w else 0

end Marches

