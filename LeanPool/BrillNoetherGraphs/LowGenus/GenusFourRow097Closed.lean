/-! ## The ramps

`RampData.repInv` — the one field the open orthant does not need — is supplied
uniformly by `RampData.of_reachIn` from `RepGen`, so each march below proves
exactly the two conditions its open counterpart proves. -/

section Ramps

/-- The census hypothesis every closed-orthant march needs: `rep`-equality is
witnessed by a chain of vanishing slots.  Free for `RowProof.censusSpec`, whose
`rep` is `compFold` of the vanishing set (`compFold_iff`). -/
def RepGen (d : DegSpec 6 9) : Prop :=
  ∀ u v : Fin 6, d.rep u = d.rep v →
    ReachIn d.core (Finset.univ.filter fun e : Fin 9 => d.length e = 0) u v

variable {d : DegSpec 6 9}

theorem vRamp (hp : IsCore097 d.core) (hrep : RepGen d) {u : ℕ}
    (hu3 : dpos d.length + u ≤ d.length 3) (hu6 : u ≤ d.length 6)
    (hu7 : u ≤ d.length 7) :
    DegSpec.RampData d (vPot u) vSgn (vLo d.length u) u := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5, hp.t6, hp.t7, hp.t8,
        hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6, hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega

theorem pRamp (hp : IsCore097 d.core) (hrep : RepGen d) {s : ℕ}
    (hs0 : s ≤ d.length 0) (hsd : s ≤ dpos d.length)
    (hd3 : dpos d.length ≤ d.length 3) (hs4 : s ≤ d.length 4) :
    DegSpec.RampData d (pPot s) pSgn (pLo d.length s) s := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5, hp.t6, hp.t7, hp.t8,
        hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6, hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega

theorem mRamp (hp : IsCore097 d.core) (hrep : RepGen d) {a r : ℕ}
    (ha : a ≤ d.length 0) (hr1 : r ≤ a) (hr2 : r ≤ d.length 5) :
    DegSpec.RampData d (mPot r) mSgn (mLo a r) r := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5, hp.t6, hp.t7, hp.t8,
        hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6, hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega

theorem wRamp (hp : IsCore097 d.core) (hrep : RepGen d) {w : ℕ}
    (hx : cRest d.length - m2Max d.length ≤ d.length 0)
    (hww : w ≤ cRest d.length - m2Max d.length) (hw1 : w ≤ d.length 1)
    (hw2 : w ≤ d.length 2) :
    DegSpec.RampData d (wPot w) wSgn (wLo d.length w) w := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5, hp.t6, hp.t7, hp.t8,
        hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6, hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega

/-- The `star 2` march. -/
def vScript (d : DegSpec 6 9) (u : ℕ) : firingScript d.graph :=
  d.rampScript (vPot u) vSgn (vLo d.length u) u

/-- The `{e0,e3,e4}` march. -/
def pScript (d : DegSpec 6 9) (s : ℕ) : firingScript d.graph :=
  d.rampScript (pPot s) pSgn (pLo d.length s) s

/-- The `{e0,e5}` march. -/
def mScript (d : DegSpec 6 9) (a r : ℕ) : firingScript d.graph :=
  d.rampScript (mPot r) mSgn (mLo a r) r

/-- The `star 0` march. -/
def wScript (d : DegSpec 6 9) (w : ℕ) : firingScript d.graph :=
  d.rampScript (wPot w) wSgn (wLo d.length w) w

end Ramps

/-! ## Divisor identities for the four marches

Each is one instantiation of the generic `DegSpec.prin_ramp_eq`, expanded over
the nine slots.  No case analysis and no heartbeat override occurs. -/

section RampEq

variable {d : DegSpec 6 9}

theorem prin_v_eq {u : ℕ} (h : DegSpec.RampData d (vPot u) vSgn (vLo d.length u) u)
    (hu6 : u ≤ d.length 6) (hu7 : u ≤ d.length 7) :
    prin d.graph (vScript d u) =
      (oneChip (G := d.graph) (d.pathAt 3 (dpos d.length + u)) -
          oneChip (d.pathAt 3 (dpos d.length))) +
        (oneChip (d.pathAt 6 (d.length 6 - u)) -
          oneChip (d.pathAt 6 (d.length 6))) +
        (oneChip (d.pathAt 7 (d.length 7 - u)) -
          oneChip (d.pathAt 7 (d.length 7))) := by
  have e6 : d.pathAt 6 (d.length 6 - u + u) = d.pathAt 6 (d.length 6) :=
    d.pathAt_of_eq 6 (by omega)
  have e7 : d.pathAt 7 (d.length 7 - u + u) = d.pathAt 7 (d.length 7) :=
    d.pathAt_of_eq 7 (by omega)
  rw [vScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [vSgn_0, vSgn_1, vSgn_2, vSgn_3, vSgn_4, vSgn_5, vSgn_6, vSgn_7,
    vSgn_8, vLo_0, vLo_1, vLo_2, vLo_3, vLo_4, vLo_5, vLo_6, vLo_7, vLo_8,
    e6, e7, zero_smul, one_smul, neg_smul]
  abel

theorem prin_p_eq {s : ℕ} (h : DegSpec.RampData d (pPot s) pSgn (pLo d.length s) s)
    (hs0 : s ≤ d.length 0) (hsd : s ≤ dpos d.length) (hs4 : s ≤ d.length 4) :
    prin d.graph (pScript d s) =
      (oneChip (G := d.graph) (d.pathAt 0 (d.length 0 - s)) -
          oneChip (d.pathAt 0 (d.length 0))) +
        (oneChip (d.pathAt 3 (dpos d.length - s)) -
          oneChip (d.pathAt 3 (dpos d.length))) +
        (oneChip (d.pathAt 4 (d.length 4 - s)) -
          oneChip (d.pathAt 4 (d.length 4))) := by
  have e0 : d.pathAt 0 (d.length 0 - s + s) = d.pathAt 0 (d.length 0) :=
    d.pathAt_of_eq 0 (by omega)
  have e3 : d.pathAt 3 (dpos d.length - s + s) = d.pathAt 3 (dpos d.length) :=
    d.pathAt_of_eq 3 (by omega)
  have e4 : d.pathAt 4 (d.length 4 - s + s) = d.pathAt 4 (d.length 4) :=
    d.pathAt_of_eq 4 (by omega)
  rw [pScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [pSgn_0, pSgn_1, pSgn_2, pSgn_3, pSgn_4, pSgn_5, pSgn_6, pSgn_7,
    pSgn_8, pLo_0, pLo_1, pLo_2, pLo_3, pLo_4, pLo_5, pLo_6, pLo_7, pLo_8,
    e0, e3, e4, zero_smul, one_smul]
  abel

theorem prin_m_eq {a r : ℕ} (h : DegSpec.RampData d (mPot r) mSgn (mLo a r) r)
    (hr1 : r ≤ a) :
    prin d.graph (mScript d a r) =
      (oneChip (G := d.graph) (d.pathAt 0 (a - r)) - oneChip (d.pathAt 0 a)) -
        (oneChip (d.pathAt 5 0) - oneChip (d.pathAt 5 r)) := by
  have e0 : d.pathAt 0 (a - r + r) = d.pathAt 0 a := d.pathAt_of_eq 0 (by omega)
  have e5 : d.pathAt 5 (0 + r) = d.pathAt 5 r := d.pathAt_of_eq 5 (by omega)
  rw [mScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [mSgn_0, mSgn_1, mSgn_2, mSgn_3, mSgn_4, mSgn_5, mSgn_6, mSgn_7,
    mSgn_8, mLo_0, mLo_1, mLo_2, mLo_3, mLo_4, mLo_5, mLo_6, mLo_7, mLo_8,
    e0, e5, zero_smul, one_smul, neg_smul]
  abel

theorem prin_w_eq {w : ℕ} (h : DegSpec.RampData d (wPot w) wSgn (wLo d.length w) w)
    (hww : w ≤ cRest d.length - m2Max d.length) (hw1 : w ≤ d.length 1)
    (hw2 : w ≤ d.length 2) :
    prin d.graph (wScript d w) =
      (oneChip (G := d.graph)
            (d.pathAt 0 (cRest d.length - m2Max d.length - w)) -
          oneChip (d.pathAt 0 (cRest d.length - m2Max d.length))) +
        (oneChip (d.pathAt 1 (d.length 1 - w)) -
          oneChip (d.pathAt 1 (d.length 1))) +
        (oneChip (d.pathAt 2 (d.length 2 - w)) -
          oneChip (d.pathAt 2 (d.length 2))) := by
  have e0 : d.pathAt 0 (cRest d.length - m2Max d.length - w + w) =
      d.pathAt 0 (cRest d.length - m2Max d.length) := d.pathAt_of_eq 0 (by omega)
  have e1 : d.pathAt 1 (d.length 1 - w + w) = d.pathAt 1 (d.length 1) :=
    d.pathAt_of_eq 1 (by omega)
  have e2 : d.pathAt 2 (d.length 2 - w + w) = d.pathAt 2 (d.length 2) :=
    d.pathAt_of_eq 2 (by omega)
  rw [wScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [wSgn_0, wSgn_1, wSgn_2, wSgn_3, wSgn_4, wSgn_5, wSgn_6, wSgn_7,
    wSgn_8, wLo_0, wLo_1, wLo_2, wLo_3, wLo_4, wLo_5, wLo_6, wLo_7, wLo_8,
    e0, e1, e2, zero_smul, one_smul]
  abel

end RampEq

/-! ## Bridging core classes and path positions

On the closed orthant these are the *only* places where a slot's two endpoints
can coincide, and `pathAt` already knows: `pathAt e k = coreVertex (head e)` for
every `k ≥ length e`, including `k = 0` on a vanishing slot. -/

section Bridge

variable {d : DegSpec 6 9}

theorem cvT0 (hp : IsCore097 d.core) : d.pathAt 0 0 = d.coreVertex 0 := by
  rw [d.pathAt_zero, hp.t0]

theorem cvT1 (hp : IsCore097 d.core) : d.pathAt 1 0 = d.coreVertex 0 := by
  rw [d.pathAt_zero, hp.t1]

theorem cvT2 (hp : IsCore097 d.core) : d.pathAt 2 0 = d.coreVertex 0 := by
  rw [d.pathAt_zero, hp.t2]

theorem cvT3 (hp : IsCore097 d.core) : d.pathAt 3 0 = d.coreVertex 1 := by
  rw [d.pathAt_zero, hp.t3]

theorem cvT4 (hp : IsCore097 d.core) : d.pathAt 4 0 = d.coreVertex 1 := by
  rw [d.pathAt_zero, hp.t4]

theorem cvT5 (hp : IsCore097 d.core) : d.pathAt 5 0 = d.coreVertex 1 := by
  rw [d.pathAt_zero, hp.t5]

theorem cvT6 (hp : IsCore097 d.core) : d.pathAt 6 0 = d.coreVertex 2 := by
  rw [d.pathAt_zero, hp.t6]

theorem cvT7 (hp : IsCore097 d.core) : d.pathAt 7 0 = d.coreVertex 2 := by
  rw [d.pathAt_zero, hp.t7]

theorem cvH0 (hp : IsCore097 d.core) :
    d.pathAt 0 (d.length 0) = d.coreVertex 4 := by
  rw [d.pathAt_length (le_refl _), hp.h0]

theorem cvH1 (hp : IsCore097 d.core) :
    d.pathAt 1 (d.length 1) = d.coreVertex 5 := by
  rw [d.pathAt_length (le_refl _), hp.h1]

theorem cvH2 (hp : IsCore097 d.core) :
    d.pathAt 2 (d.length 2) = d.coreVertex 5 := by
  rw [d.pathAt_length (le_refl _), hp.h2]

theorem cvH3 (hp : IsCore097 d.core) :
    d.pathAt 3 (d.length 3) = d.coreVertex 2 := by
  rw [d.pathAt_length (le_refl _), hp.h3]

theorem cvH4 (hp : IsCore097 d.core) :
    d.pathAt 4 (d.length 4) = d.coreVertex 3 := by
  rw [d.pathAt_length (le_refl _), hp.h4]

theorem cvH5 (hp : IsCore097 d.core) :
    d.pathAt 5 (d.length 5) = d.coreVertex 5 := by
  rw [d.pathAt_length (le_refl _), hp.h5]

theorem cvH6 (hp : IsCore097 d.core) :
    d.pathAt 6 (d.length 6) = d.coreVertex 3 := by
  rw [d.pathAt_length (le_refl _), hp.h6]

theorem cvH7 (hp : IsCore097 d.core) :
    d.pathAt 7 (d.length 7) = d.coreVertex 4 := by
  rw [d.pathAt_length (le_refl _), hp.h7]

end Bridge

/-! ## The pencil and the states it passes through -/

section States

/-- The degree-three pencil of row 097. -/
def pen (d : DegSpec 6 9) : CFDiv d.graph :=
  oneChip (d.pathAt 3 (dpos d.length)) + oneChip (d.coreVertex 3) +
    oneChip (d.coreVertex 4)

variable {d : DegSpec 6 9}

theorem deg_pen : deg (pen d) = 3 := by
  unfold pen
  rw [deg.map_add, deg.map_add, deg_one_chip, deg_one_chip, deg_one_chip]
  norm_num

theorem state_v (hp : IsCore097 d.core) (hrep : RepGen d) {u : ℕ}
    (hu3 : dpos d.length + u ≤ d.length 3) (hu6 : u ≤ d.length 6)
    (hu7 : u ≤ d.length 7) :
    pen d + prin d.graph (vScript d u) =
      oneChip (G := d.graph) (d.pathAt 3 (dpos d.length + u)) +
        oneChip (d.pathAt 6 (d.length 6 - u)) +
        oneChip (d.pathAt 7 (d.length 7 - u)) := by
  rw [pen, prin_v_eq (vRamp hp hrep hu3 hu6 hu7) hu6 hu7, cvH6 hp, cvH7 hp]
  abel

theorem state_p (hp : IsCore097 d.core) (hrep : RepGen d) {s : ℕ}
    (hs0 : s ≤ d.length 0) (hsd : s ≤ dpos d.length)
    (hd3 : dpos d.length ≤ d.length 3) (hs4 : s ≤ d.length 4) :
    pen d + prin d.graph (pScript d s) =
      oneChip (G := d.graph) (d.pathAt 0 (d.length 0 - s)) +
        oneChip (d.pathAt 3 (dpos d.length - s)) +
        oneChip (d.pathAt 4 (d.length 4 - s)) := by
  rw [pen, prin_p_eq (pRamp hp hrep hs0 hsd hd3 hs4) hs0 hsd hs4, cvH4 hp,
    cvH0 hp]
  abel

theorem state_m1 (hp : IsCore097 d.core) (hrep : RepGen d)
    (hd0 : dpos d.length ≤ d.length 0) (hd3 : dpos d.length ≤ d.length 3)
    (hd4 : dpos d.length ≤ d.length 4) {r : ℕ} (hr : r ≤ d.length 5)
    (hrle : r ≤ d.length 0 - dpos d.length) :
    pen d + prin d.graph (pScript d (dpos d.length) +
        mScript d (d.length 0 - dpos d.length) r) =
      oneChip (G := d.graph)
          (d.pathAt 0 (d.length 0 - dpos d.length - r)) +
        oneChip (d.pathAt 5 r) +
        oneChip (d.pathAt 4 (d.length 4 - dpos d.length)) := by
  have hz : d.pathAt 3 (dpos d.length - dpos d.length) = d.pathAt 5 0 := by
    rw [d.pathAt_of_eq 3 (Nat.sub_self _), cvT3 hp, cvT5 hp]
  rw [map_add, ← add_assoc, state_p hp hrep hd0 le_rfl hd3 hd4,
    prin_m_eq (a := d.length 0 - dpos d.length)
      (mRamp hp hrep (by omega) hrle hr) hrle, hz]
  abel

theorem state_m2 (hp : IsCore097 d.core) (hrep : RepGen d)
    (hd0 : dpos d.length ≤ d.length 0) (hd3 : dpos d.length ≤ d.length 3)
    (hd4 : dpos d.length ≤ d.length 4)
    (hcase : d.length 4 = dpos d.length)
    (h5 : d.length 5 ≤ d.length 0 - dpos d.length)
    {r : ℕ} (hr : r ≤ d.length 5) (hrc : r ≤ cRest d.length) :
    pen d + prin d.graph (pScript d (dpos d.length) +
        mScript d (d.length 0 - dpos d.length) (d.length 5) +
        mScript d (cRest d.length) r) =
      oneChip (G := d.graph) (d.pathAt 0 (cRest d.length - r)) +
        oneChip (d.pathAt 5 r) + oneChip (d.coreVertex 5) := by
  have hcr : cRest d.length ≤ d.length 0 := by simp only [cRest]; omega
  have heq0 : d.pathAt 0 (d.length 0 - dpos d.length - d.length 5) =
      d.pathAt 0 (cRest d.length) :=
    d.pathAt_of_eq 0 (by simp only [cRest]; omega)
  have hz4 : d.pathAt 4 (d.length 4 - dpos d.length) = d.pathAt 5 0 := by
    rw [d.pathAt_of_eq 4 (show d.length 4 - dpos d.length = 0 by omega),
      cvT4 hp, cvT5 hp]
  rw [map_add, ← add_assoc, state_m1 hp hrep hd0 hd3 hd4 le_rfl h5,
    prin_m_eq (mRamp hp hrep hcr hrc hr) hrc, hz4, heq0, cvH5 hp]
  abel

theorem state_w (hp : IsCore097 d.core) (hrep : RepGen d)
    (hd0 : dpos d.length ≤ d.length 0) (hd3 : dpos d.length ≤ d.length 3)
    (hd4 : dpos d.length ≤ d.length 4)
    (hcase : d.length 4 = dpos d.length)
    (h5 : d.length 5 ≤ d.length 0 - dpos d.length)
    (hm2 : m2Max d.length = d.length 5)
    {w : ℕ} (hww : w ≤ cRest d.length - m2Max d.length)
    (hw1 : w ≤ d.length 1) (hw2 : w ≤ d.length 2) :
    pen d + prin d.graph (pScript d (dpos d.length) +
        mScript d (d.length 0 - dpos d.length) (d.length 5) +
        mScript d (cRest d.length) (d.length 5) + wScript d w) =
      oneChip (G := d.graph)
          (d.pathAt 0 (cRest d.length - m2Max d.length - w)) +
        oneChip (d.pathAt 1 (d.length 1 - w)) +
        oneChip (d.pathAt 2 (d.length 2 - w)) := by
  have hcr : cRest d.length ≤ d.length 0 := by simp only [cRest]; omega
  have h5c : d.length 5 ≤ cRest d.length := by
    have hm := hm2; simp only [m2Max] at hm; omega
  have hx : cRest d.length - m2Max d.length ≤ d.length 0 := by omega
  have heq0 : d.pathAt 0 (cRest d.length - d.length 5) =
      d.pathAt 0 (cRest d.length - m2Max d.length) :=
    d.pathAt_of_eq 0 (by omega)
  rw [map_add, ← add_assoc,
    state_m2 hp hrep hd0 hd3 hd4 hcase h5 le_rfl h5c,
    prin_w_eq (wRamp hp hrep hx hww hw1 hw2) hww hw1 hw2, heq0, cvH1 hp,
    cvH2 hp, cvH5 hp]
  abel

end States

/-! ## Reaching every core class -/

section Assembly

variable {d : DegSpec 6 9}

theorem chip_three (A B C q : d.graph.V) (hq : q = A ∨ q = B ∨ q = C) :
    1 ≤ (oneChip A + oneChip B + oneChip C) q := by
  rcases hq with rfl | rfl | rfl
  · exact threeChipDivisor_has_chip_first _ _ _
  · exact threeChipDivisor_has_chip_second _ _ _
  · exact threeChipDivisor_has_chip_third _ _ _

theorem reaches_three (script : firingScript d.graph) (A B C : d.graph.V)
    (hst : pen d + prin d.graph script = oneChip A + oneChip B + oneChip C)
    (q : d.graph.V) (hq : q = A ∨ q = B ∨ q = C) :
    StrongSeparator.Reaches d.graph (pen d) q := by
  refine d.reaches_of_script (pen d) script q ?_ ?_
  · rw [hst]
    exact threeChipDivisor_effective A B C
  · rw [hst]
    exact chip_three A B C q hq

end Assembly

/-! ## The covering argument -/

section Cover

variable {d : DegSpec 6 9}

theorem bounds (hba : d.length 5 ≤ d.length 0) (hbc : d.length 4 ≤ d.length 3) :
    dpos d.length ≤ d.length 4 ∧ dpos d.length ≤ d.length 3 ∧
      dpos d.length ≤ d.length 0 ∧
      d.length 5 ≤ d.length 0 - dpos d.length := by
  simp only [dpos]
  omega

theorem uBounds (hbc : d.length 4 ≤ d.length 3) :
    dpos d.length + uMax d.length ≤ d.length 3 ∧
      uMax d.length ≤ d.length 6 ∧ uMax d.length ≤ d.length 7 := by
  have hd4 : dpos d.length ≤ d.length 4 := by simp only [dpos]; omega
  simp only [uMax]
  omega

theorem wLen (hba : d.length 5 ≤ d.length 0) :
    cRest d.length - m2Max d.length ≤ d.length 0 := by
  simp only [cRest, m2Max, dpos]
  omega

theorem wBounds : wMax d.length ≤ cRest d.length - m2Max d.length ∧
    wMax d.length ≤ d.length 1 ∧ wMax d.length ≤ d.length 2 := by
  simp only [wMax]
  omega

theorem mBounds : m2Max d.length ≤ cRest d.length ∧
    m2Max d.length ≤ d.length 5 := by
  simp only [m2Max]
  omega

theorem cRest_le (hba : d.length 5 ≤ d.length 0) :
    cRest d.length ≤ d.length 0 := by
  simp only [cRest]
  omega

/-- A nonzero residual imbalance forces the moving chip to sit at the far end
of slot `e4`. -/
theorem dpos_eq_of_cRest_pos (h : 0 < cRest d.length) :
    d.length 4 = dpos d.length := by
  simp only [cRest, dpos] at h ⊢
  omega

/-- If the `star 0` march is nontrivial then the second `{e0,e5}` pass ran to
the end of slot `e5`. -/
theorem m2Max_eq_of_pos (h : 0 < cRest d.length - m2Max d.length) :
    m2Max d.length = d.length 5 := by
  simp only [m2Max] at h ⊢
  omega

theorem cRest_pos_of (h : 0 < cRest d.length - m2Max d.length) :
    0 < cRest d.length := by
  have := (mBounds (d := d)).1
  omega

/-- A state with chips at both banana endpoints, available whenever the
`star 0` march is trivial. -/
theorem banana_pair (hp : IsCore097 d.core) (hrep : RepGen d)
    (hba : d.length 5 ≤ d.length 0) (hbc : d.length 4 ≤ d.length 3)
    (hx0 : cRest d.length - m2Max d.length = 0) :
    ∃ (script : firingScript d.graph) (Z : d.graph.V),
      pen d + prin d.graph script =
        oneChip (d.coreVertex 0) + oneChip (d.coreVertex 5) + oneChip Z := by
  obtain ⟨hd4, hd3, hd0, h5⟩ := bounds hba hbc
  have hcr : cRest d.length ≤ d.length 0 := cRest_le hba
  by_cases hcase : d.length 4 = dpos d.length
  · refine ⟨pScript d (dpos d.length) +
      mScript d (d.length 0 - dpos d.length) (d.length 5) +
      mScript d (cRest d.length) (m2Max d.length),
      d.pathAt 5 (m2Max d.length), ?_⟩
    rw [state_m2 hp hrep hd0 hd3 hd4 hcase h5 (mBounds (d := d)).2
      (mBounds (d := d)).1]
    have e1 : d.pathAt 0 (cRest d.length - m2Max d.length) = d.coreVertex 0 := by
      rw [d.pathAt_of_eq 0 hx0, cvT0 hp]
    rw [e1]
    abel
  · have hc0 : cRest d.length = 0 := by
      simp only [cRest, dpos] at *
      omega
    refine ⟨pScript d (dpos d.length) +
      mScript d (d.length 0 - dpos d.length) (d.length 5),
      d.pathAt 4 (d.length 4 - dpos d.length), ?_⟩
    rw [state_m1 hp hrep hd0 hd3 hd4 le_rfl h5]
    have e1 : d.pathAt 0 (d.length 0 - dpos d.length - d.length 5) =
        d.coreVertex 0 := by
      rw [d.pathAt_of_eq 0 (show d.length 0 - dpos d.length - d.length 5 = 0 by
        simp only [cRest] at hc0; omega), cvT0 hp]
    have e2 : d.pathAt 5 (d.length 5) = d.coreVertex 5 := cvH5 hp
    rw [e1, e2]

/-- At the end of the `star 2` march there is a chip at the hub `2`. -/
theorem hub_two (hp : IsCore097 d.core) (hbc : d.length 4 ≤ d.length 3) :
    d.coreVertex 2 = d.pathAt 3 (dpos d.length + uMax d.length) ∨
      d.coreVertex 2 = d.pathAt 6 (d.length 6 - uMax d.length) ∨
      d.coreVertex 2 = d.pathAt 7 (d.length 7 - uMax d.length) := by
  obtain ⟨hU3, hU6, hU7⟩ := uBounds hbc
  have hd4 : dpos d.length ≤ d.length 4 := by simp only [dpos]; omega
  have hcase : dpos d.length + uMax d.length = d.length 3 ∨
      d.length 6 - uMax d.length = 0 ∨ d.length 7 - uMax d.length = 0 := by
    simp only [uMax] at *
    omega
  rcases hcase with hc | hc | hc
  · exact Or.inl (by rw [← cvH3 hp, d.pathAt_of_eq 3 hc])
  · exact Or.inr (Or.inl (by rw [← cvT6 hp, d.pathAt_of_eq 6 hc]))
  · exact Or.inr (Or.inr (by rw [← cvT7 hp, d.pathAt_of_eq 7 hc]))

/-- At the end of the `star 0` march there is a chip at the vertex `0`. -/
theorem hub_zero (hp : IsCore097 d.core) (hba : d.length 5 ≤ d.length 0) :
    d.coreVertex 0 =
        d.pathAt 0 (cRest d.length - m2Max d.length - wMax d.length) ∨
      d.coreVertex 0 = d.pathAt 1 (d.length 1 - wMax d.length) ∨
      d.coreVertex 0 = d.pathAt 2 (d.length 2 - wMax d.length) := by
  have hw := wLen (d := d) hba
  have hcase : cRest d.length - m2Max d.length - wMax d.length = 0 ∨
      d.length 1 - wMax d.length = 0 ∨ d.length 2 - wMax d.length = 0 := by
    simp only [wMax] at *
    omega
  rcases hcase with hc | hc | hc
  · exact Or.inl (by rw [← cvT0 hp, d.pathAt_of_eq 0 hc])
  · exact Or.inr (Or.inl (by rw [← cvT1 hp, d.pathAt_of_eq 1 hc]))
  · exact Or.inr (Or.inr (by rw [← cvT2 hp, d.pathAt_of_eq 2 hc]))

/-- **Every core class is reached.** -/
theorem reaches_core (hp : IsCore097 d.core) (hrep : RepGen d)
    (hba : d.length 5 ≤ d.length 0) (hbc : d.length 4 ≤ d.length 3)
    (v : Fin 6) :
    StrongSeparator.Reaches d.graph (pen d) (d.coreVertex v) := by
  obtain ⟨hd4, hd3, hd0, h5⟩ := bounds hba hbc
  obtain ⟨hU3, hU6, hU7⟩ := uBounds hbc
  obtain ⟨hmc, hm5⟩ := mBounds (d := d)
  obtain ⟨hW0, hW1, hW2⟩ := wBounds (d := d)
  have hcr := cRest_le (d := d) hba
  revert v
  refine forall_fin_six ?_ ?_ ?_ ?_ ?_ ?_
  · -- the banana vertex `0`
    by_cases hx0 : cRest d.length - m2Max d.length = 0
    · obtain ⟨script, Z, hst⟩ := banana_pair hp hrep hba hbc hx0
      exact reaches_three script _ _ _ hst _ (Or.inl rfl)
    · have hpos : 0 < cRest d.length - m2Max d.length := by omega
      have hcase := dpos_eq_of_cRest_pos (cRest_pos_of hpos)
      have hm2 := m2Max_eq_of_pos hpos
      exact reaches_three _ _ _ _
        (state_w (w := wMax d.length) hp hrep hd0 hd3 hd4 hcase h5 hm2 hW0 hW1
          hW2) _ (hub_zero hp hba)
  · -- the theta arc vertex `1`
    refine reaches_three _ _ _ _
      (state_p (s := dpos d.length) hp hrep hd0 le_rfl hd3 hd4) _
      (Or.inr (Or.inl ?_))
    rw [d.pathAt_of_eq 3 (Nat.sub_self _), cvT3 hp]
  · -- the hub `2`
    exact reaches_three _ _ _ _
      (state_v (u := uMax d.length) hp hrep hU3 hU6 hU7) _ (hub_two hp hbc)
  · -- the hub `3`, carried by the pencil itself
    refine reaches_three 0 (d.pathAt 3 (dpos d.length)) (d.coreVertex 3)
      (d.coreVertex 4) ?_ _ (Or.inr (Or.inl rfl))
    rw [map_zero, add_zero, pen]
  · -- the handle vertex `4`, carried by the pencil itself
    refine reaches_three 0 (d.pathAt 3 (dpos d.length)) (d.coreVertex 3)
      (d.coreVertex 4) ?_ _ (Or.inr (Or.inr rfl))
    rw [map_zero, add_zero, pen]
  · -- the banana vertex `5`
    refine reaches_three _ _ _ _
      (state_m1 (r := d.length 5) hp hrep hd0 hd3 hd4 le_rfl h5) _
      (Or.inr (Or.inl ?_))
    exact (cvH5 hp).symm

/-- **Row 097 on the closed orthant, in the chamber
`length 5 ≤ length 0`, `length 4 ≤ length 3`.** -/
theorem bnExists_one_three (hp : IsCore097 d.core) (hrep : RepGen d)
    (hba : d.length 5 ≤ d.length 0) (hbc : d.length 4 ≤ d.length 3) :
    BNExists d.graph 1 3 :=
  bnExists_of_reaches_coreVertices d hp.core_connected (pen d) 3 deg_pen
    (fun v => reaches_core hp hrep hba hbc v)

end Cover

/-! ## The catalog row, on the closed orthant

An arbitrary length vector is moved into the chamber
`length 5 ≤ length 0 ∧ length 4 ≤ length 3` by the Klein four-group of
automorphisms of the row-097 core, transported with
`ClosedCoreSymmetry.bnExists_iff` — the closed-orthant counterpart of
`Certificate/SubdivisionIso.lean`'s `bnExists_of_coreAuto`.  The transport is
along the *contracted* graphs, so the chamber reduction costs nothing extra at
a face. -/

section Row

open Utilities.Certificate.CoreOrbitReduction

/-- The row-097 split core is the public cubic-atlas presentation. -/
abbrev core : ExplicitPotential.Core 6 9 :=
  AtanasovRanganathan.GenusFourCubicAtlas.row097Core

theorem isCore097_core : IsCore097 core := by constructor <;> decide

/-- `σ = (0 5)(1 4)` on core vertices. -/
def sigVertex : Equiv.Perm (Fin 6) where
  toFun := ![5, 4, 2, 3, 1, 0]
  invFun := ![5, 4, 2, 3, 1, 0]
  left_inv := by decide
  right_inv := by decide

/-- `σ` on edge slots: `e0 ↔ e5`, `e3 ↔ e7`, `e4 ↔ e8`. -/
def sigSlot : Equiv.Perm (Fin 9) where
  toFun := ![5, 1, 2, 7, 8, 0, 6, 3, 4]
  invFun := ![5, 1, 2, 7, 8, 0, 6, 3, 4]
  left_inv := by decide
  right_inv := by decide

/-- Reading directions of the `σ`-image slots. -/
def sigReversed : Fin 9 → Bool :=
  ![true, true, true, true, true, true, false, true, true]

/-- `τ = (2 3)` on core vertices. -/
def tauVertex : Equiv.Perm (Fin 6) where
  toFun := ![0, 1, 3, 2, 4, 5]
  invFun := ![0, 1, 3, 2, 4, 5]
  left_inv := by decide
  right_inv := by decide

/-- `τ` on edge slots: `e3 ↔ e4`, `e7 ↔ e8`. -/
def tauSlot : Equiv.Perm (Fin 9) where
  toFun := ![0, 1, 2, 4, 3, 5, 6, 8, 7]
  invFun := ![0, 1, 2, 4, 3, 5, 6, 8, 7]
  left_inv := by decide
  right_inv := by decide

/-- Reading directions of the `τ`-image slots. -/
def tauReversed : Fin 9 → Bool :=
  ![false, false, false, false, false, false, true, false, false]

/-- `σ`, as a core symmetry. -/
def sigma : CoreSymmetry core where
  vertexPerm := sigVertex
  slotPerm := sigSlot
  reversed := sigReversed
  tail_eq := by decide
  head_eq := by decide

/-- `τ`, as a core symmetry. -/
def tau : CoreSymmetry core where
  vertexPerm := tauVertex
  slotPerm := tauSlot
  reversed := tauReversed
  tail_eq := by decide
  head_eq := by decide

/-- `censusSpec`'s representative map is a `compFold` of the vanishing set, so
`RepGen` — the one hypothesis a closed-orthant ramp needs beyond the
open-orthant ones — is free. -/
theorem repGen_censusSpec (ℓ : Fin 9 → ℕ)
    (hForest : IsForest core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy core (zeroSet ℓ)) :
    RepGen (censusSpec core (by norm_num) ℓ hForest hNotLoopy) :=
  fun u v h => (compFold_iff core (zeroSet ℓ) u v).mp h

/-- **`BNExists … 1 3` for catalog row `097`, on the whole closed length
orthant.**  Quantified over every length vector whose vanishing set is a
non-loopy forest — every subdivision of the row-097 core *and* every
equal-genus contraction of one.

No Boolean check, no generated data, and no length chamber decomposition
occurs anywhere below: the four cases are the orbit of one under the core's
Klein four-group. -/
theorem bnExists_closed (ℓ : Fin 9 → ℕ)
    (hForest : IsForest core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy core (zeroSet ℓ)) :
    BNExists (censusSpec core (by norm_num) ℓ hForest hNotLoopy).graph 1 3 := by
  have ht0 : (tau.slotPerm.symm : Fin 9 → Fin 9) 0 = 0 := by decide
  have ht3 : (tau.slotPerm.symm : Fin 9 → Fin 9) 3 = 4 := by decide
  have ht4 : (tau.slotPerm.symm : Fin 9 → Fin 9) 4 = 3 := by decide
  have ht5 : (tau.slotPerm.symm : Fin 9 → Fin 9) 5 = 5 := by decide
  have hs0 : (sigma.slotPerm.symm : Fin 9 → Fin 9) 0 = 5 := by decide
  have hs3 : (sigma.slotPerm.symm : Fin 9 → Fin 9) 3 = 7 := by decide
  have hs4 : (sigma.slotPerm.symm : Fin 9 → Fin 9) 4 = 8 := by decide
  have hs5 : (sigma.slotPerm.symm : Fin 9 → Fin 9) 5 = 0 := by decide
  by_cases h50 : ℓ 5 ≤ ℓ 0
  · by_cases h43 : ℓ 4 ≤ ℓ 3
    · exact bnExists_one_three isCore097_core
        (repGen_censusSpec ℓ hForest hNotLoopy) h50 h43
    · refine (ClosedCoreSymmetry.bnExists_iff tau ℓ (by norm_num) hForest hNotLoopy
        1 3).mp ?_
      refine bnExists_one_three isCore097_core
        (repGen_censusSpec _ _ _) ?_ ?_
      · change ℓ ((tau.slotPerm.symm : Fin 9 → Fin 9) 5) ≤
          ℓ ((tau.slotPerm.symm : Fin 9 → Fin 9) 0)
        rw [ht5, ht0]; exact h50
      · change ℓ ((tau.slotPerm.symm : Fin 9 → Fin 9) 4) ≤
          ℓ ((tau.slotPerm.symm : Fin 9 → Fin 9) 3)
        rw [ht4, ht3]; omega
  · by_cases h87 : ℓ 8 ≤ ℓ 7
    · refine (ClosedCoreSymmetry.bnExists_iff sigma ℓ (by norm_num) hForest hNotLoopy
        1 3).mp ?_
      refine bnExists_one_three isCore097_core
        (repGen_censusSpec _ _ _) ?_ ?_
      · change ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9) 5) ≤
          ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9) 0)
        rw [hs5, hs0]; omega
      · change ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9) 4) ≤
          ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9) 3)
        rw [hs4, hs3]; exact h87
    · refine (ClosedCoreSymmetry.bnExists_iff sigma ℓ (by norm_num) hForest hNotLoopy
        1 3).mp ?_
      refine (ClosedCoreSymmetry.bnExists_iff tau
        (ClosedCoreSymmetry.targetLength sigma ℓ)
        (by norm_num) _ _ 1 3).mp ?_
      refine bnExists_one_three isCore097_core
        (repGen_censusSpec _ _ _) ?_ ?_
      · change ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9)
            ((tau.slotPerm.symm : Fin 9 → Fin 9) 5)) ≤
          ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9)
            ((tau.slotPerm.symm : Fin 9 → Fin 9) 0))
        rw [ht5, ht0, hs5, hs0]; omega
      · change ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9)
            ((tau.slotPerm.symm : Fin 9 → Fin 9) 4)) ≤
          ℓ ((sigma.slotPerm.symm : Fin 9 → Fin 9)
            ((tau.slotPerm.symm : Fin 9 → Fin 9) 3))
        rw [ht4, ht3, hs3, hs4]; omega

/-- The object the conclusion speaks about has the row's genus at every face. -/
theorem genus_eq (ℓ : Fin 9 → ℕ)
    (hForest : IsForest core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy core (zeroSet ℓ)) :
    genus (censusSpec core (by norm_num) ℓ hForest hNotLoopy).graph = 4 := by
  rw [DegSpec.genus_graph]
  norm_num

end Row

end LowGenus.GenusFourRow097Closed
